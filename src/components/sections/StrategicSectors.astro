---
// src/components/sections/StrategicSectors.astro
const base = import.meta.env.BASE_URL;

const sectors = [
  {
    id: 'mineria',
    title: 'Minería Sustentable & Litio',
    description:
      'Extracción responsable, energías para la transición global y la cadena de valor de proveedores locales.',
    image: '/images/sectors/mineria.jpg',
    shortName: 'Minería & Litio',
    badge: 'Transición Energética',
    territory: 'puna',
  },
  {
    id: 'agroindustria',
    title: 'Agroindustria con Identidad',
    description:
      'Valor agregado en origen, producción tabacalera, cañera, cooperativas agrícolas y alimentos andinos de exportación.',
    image: '/images/sectors/agroindustria.jpg',
    shortName: 'Agroindustria',
    badge: 'Producción Regional',
    territory: 'valles',
  },
  {
    id: 'tecnologia',
    title: 'Tecnología e Industrias del Conocimiento',
    description:
      'Soluciones digitales, automatización, software y el talento joven jujeño exportando servicios al mundo.',
    image: '/images/sectors/tecnologia.jpg',
    shortName: 'Tecnología',
    badge: 'Economía del Conocimiento',
    territory: 'yungas',
  },
  {
    id: 'turismo',
    title: 'Turismo, Gastronomía & Comercio',
    description:
      'Patrimonio cultural, hotelería, servicios esenciales y el entramado comercial que mueve el consumo local.',
    image: '/images/sectors/turismo.jpg',
    shortName: 'Turismo & Comercio',
    badge: 'Destino Internacional',
    territory: 'quebrada',
  },
  {
    id: 'industria-logistica',
    title: 'Industria, Construcción & Logística',
    description:
      'Grandes empresas, manufactura, infraestructura pesada y la red de servicios corporativos de la provincia.',
    image: '/images/sectors/transporteylogistica.jpg',
    shortName: 'Industria & Logística',
    badge: 'Corredor Bioceánico',
    territory: 'yungas',
  },
  {
    id: 'emprendimientos',
    title: 'Emprendimientos & Economía Popular',
    description:
      'Cooperativas artesanales, micro-PyMEs y proyectos emergentes que transforman la capacidad local en desarrollo genuino.',
    image: '/images/sectors/emprendimientos.jpg',
    shortName: 'Emprendimientos',
    badge: 'Desarrollo Comunitario',
    territory: 'valles',
  },
];
---

<section
  class="productive-ecosystem section"
  id="sectores"
  data-progressive-carousel
  aria-labelledby="ecosystem-title"
>
  <div class="container">
    <div class="ecosystem-heading">
      <div>
        <p class="eyebrow">ECOSISTEMA PRODUCTIVO</p>
      </div>

      <a
        href={`${base === '/' ? '/expositores' : `${base}expositores`}`}
        class="ecosystem-link"
      >
        Ver todos los expositores
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="ecosystem-layout">
      <div class="ecosystem-copy">
        <div class="ecosystem-statement" id="ecosystem-title">
          <span class="ecosystem-statement__plus">+6</span>

          <span class="ecosystem-statement__text">
            <span>de sectores,</span>
            <span>un solo</span>
            <span>escenario</span>
          </span>
        </div>

        <div class="ecosystem-active-info">
          <p class="ecosystem-active-index" data-active-index>
            01 / 06
          </p>

          <h2 data-active-title>
            {sectors[0].title}
          </h2>

          <p data-active-description>
            {sectors[0].description}
          </p>
        </div>
      </div>

      <div class="ecosystem-visual">
        <div class="ecosystem-stage" data-carousel-stage>
          {sectors.map((sector, index) => (
            <div
              class={`ecosystem-slide ${index === 0 ? 'is-active' : ''}`}
              id={`ecosystem-slide-${sector.id}`}
              data-carousel-slide
              data-index={index}
              role="tabpanel"
              aria-labelledby={`ecosystem-tab-${sector.id}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <img
                src={sector.image}
                alt={sector.title}
                class="ecosystem-slide__image"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="ecosystem-slide__overlay" aria-hidden="true" />
              <div class="ecosystem-slide__content">
                <span class="ecosystem-slide__badge">{sector.badge}</span>
                <p class="ecosystem-slide__headline">{sector.title}</p>
              </div>
            </div>
          ))}
        </div>

        <div
          class="ecosystem-controls"
          data-carousel-controls
          role="tablist"
          aria-label="Sectores del ecosistema productivo"
        >
          {sectors.map((sector, index) => (
            <button
              type="button"
              class={`ecosystem-control ${index === 0 ? 'is-active' : ''}`}
              id={`ecosystem-tab-${sector.id}`}
              data-carousel-trigger
              data-index={index}
              data-title={sector.title}
              data-desc={sector.description}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`ecosystem-slide-${sector.id}`}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="ecosystem-control__number">0{index + 1}</span>
              <span class="ecosystem-control__name">{sector.shortName}</span>
              <span class="ecosystem-control__progress" aria-hidden="true" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .productive-ecosystem {
    background-color: var(--color-paper, #f2f2f2);
    position: relative;
    margin-top: 0;
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 104px);
  }

  .ecosystem-heading {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .eyebrow {
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--theme-primary, #4a1d96);
    margin: 0;
    transition: color 250ms ease;
  }

  .ecosystem-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--theme-primary, #4a1d96);
    text-decoration: none;
    transition: gap 200ms ease, color 200ms ease;
    white-space: nowrap;
    padding-bottom: 2px;
  }

  .ecosystem-link:hover {
    gap: 0.75rem;
    color: var(--theme-primary-hover, #3b1478);
  }

  .ecosystem-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.45fr);
    align-items: center;
    gap: clamp(48px, 8vw, 128px);
    margin-top: 24px;
  }

  .ecosystem-copy {
    max-width: 460px;
  }

  .ecosystem-statement {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    max-width: 460px;
    color: var(--color-ink, #3c3c3b);
  }

  .ecosystem-statement__plus {
    flex: 0 0 auto;
    margin: 0;
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: clamp(78px, 8vw, 132px);
    font-weight: 700;
    line-height: 0.76;
    letter-spacing: -0.09em;
  }

  .ecosystem-statement__text {
    display: flex;
    flex-direction: column;
    padding-top: 5px;
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: clamp(34px, 4vw, 62px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .ecosystem-active-info {
    max-width: 420px;
    margin-top: clamp(44px, 6vw, 78px);
  }

  .ecosystem-active-index {
    margin: 0 0 20px;
    color: var(--theme-primary, #4a1d96);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-family: 'Ambit', monospace, sans-serif;
    transition: color 250ms ease;
  }

  .ecosystem-active-info h2 {
    max-width: 420px;
    margin: 0 0 16px;
    color: var(--color-ink, #3c3c3b);
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .ecosystem-active-info p {
    max-width: 400px;
    margin: 0;
    color: var(--color-ink-muted, rgb(60 60 59 / 72%));
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.45;
  }

  .ecosystem-visual {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ecosystem-stage {
    position: relative;
    min-height: 500px;
    height: 520px;
    overflow: hidden;
    border: 1px solid rgb(60 60 59 / 12%);
    border-radius: 16px;
    background: var(--color-surface, #ffffff);
    box-shadow: 0 14px 38px rgb(60 60 59 / 10%);
  }

  .ecosystem-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.025);
    transition:
      opacity 650ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 650ms ease,
      transform 850ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ecosystem-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .ecosystem-slide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ecosystem-slide.is-active .ecosystem-slide__image {
    transform: scale(1.03);
  }

  .ecosystem-slide__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(0 0 0 / 42%) 0%,
        rgb(0 0 0 / 12%) 58%,
        transparent 100%
      ),
      linear-gradient(
        0deg,
        rgb(0 0 0 / 68%) 0%,
        transparent 62%
      );
  }

  .ecosystem-slide__content {
    position: absolute;
    left: clamp(20px, 4vw, 36px);
    bottom: clamp(20px, 4vw, 36px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: 82%;
  }

  .ecosystem-slide__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 11px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ecosystem-slide__headline {
    font-family: 'Ambit', system-ui, sans-serif;
    color: #ffffff;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 700;
    line-height: 1.25;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
    margin: 0;
  }

  .ecosystem-controls {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 12px;
    background: rgb(20 20 20 / 65%);
    box-shadow:
      0 12px 32px rgb(0 0 0 / 14%),
      inset 0 1px 0 rgb(255 255 255 / 12%);
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    margin-top: 14px;
  }

  .ecosystem-control {
    position: relative;
    min-width: 0;
    min-height: 82px;
    padding: 13px 14px;
    border: 0;
    border-right: 1px solid rgb(255 255 255 / 12%);
    background: transparent;
    color: rgb(255 255 255 / 70%);
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  .ecosystem-control:last-child {
    border-right: 0;
  }

  .ecosystem-control:hover {
    background: rgb(255 255 255 / 10%);
    color: #ffffff;
  }

  .ecosystem-control[aria-selected='true'] {
    background: rgb(255 255 255 / 14%);
    color: #ffffff;
  }

  .ecosystem-control__number {
    font-family: 'Ambit', monospace, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    opacity: 0.75;
  }

  .ecosystem-control__name {
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ecosystem-control__progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--theme-primary, #6b21a8);
    opacity: 0;
  }

  .ecosystem-control[aria-selected='true'] .ecosystem-control__progress {
    opacity: 1;
    animation: ecosystem-progress 5000ms linear forwards;
  }

  .productive-ecosystem.is-paused .ecosystem-control[aria-selected='true'] .ecosystem-control__progress {
    animation-play-state: paused;
  }

  @keyframes ecosystem-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Responsive Mobile */
  @media (max-width: 767px) {
    .ecosystem-statement {
      gap: 12px;
      max-width: 100%;
    }

    .ecosystem-statement__plus {
      font-size: clamp(64px, 19vw, 94px);
    }

    .ecosystem-statement__text {
      padding-top: 3px;
      font-size: clamp(28px, 8vw, 44px);
      line-height: 0.92;
    }

    .ecosystem-active-info {
      margin-top: 38px;
    }

    .ecosystem-layout {
      display: flex;
      flex-direction: column;
      gap: 32px;
      margin-top: 24px;
    }

    .ecosystem-copy {
      max-width: none;
    }

    .ecosystem-stage {
      min-height: 390px;
      height: 390px;
      border-radius: 12px;
    }

    .ecosystem-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-radius: 10px;
    }

    .ecosystem-control {
      min-height: 86px;
      padding: 12px;
    }

    .ecosystem-control:nth-child(2n) {
      border-right: 0;
    }

    .ecosystem-control:nth-child(-n + 4) {
      border-bottom: 1px solid rgb(255 255 255 / 12%);
    }
  }

  /* Responsive Tablet */
  @media (min-width: 768px) and (max-width: 1023px) {
    .ecosystem-layout {
      grid-template-columns: 1fr 1.35fr;
      gap: 40px;
      margin-top: 44px;
    }

    .ecosystem-controls {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ecosystem-control:nth-child(3n) {
      border-right: 0;
    }

    .ecosystem-control:nth-child(-n + 3) {
      border-bottom: 1px solid rgb(255 255 255 / 12%);
    }
  }

  /* Accessibility: Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .ecosystem-slide,
    .ecosystem-slide__image,
    .ecosystem-control {
      transition: none !important;
    }
    .ecosystem-control__progress {
      animation: none !important;
      opacity: 0 !important;
    }
  }
</style>

<script>
  function initProgressiveCarousel() {
    const carousel = document.querySelector('[data-progressive-carousel]');
    if (!carousel || carousel.hasAttribute('data-ready')) return;
    carousel.setAttribute('data-ready', 'true');

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const controls = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-trigger]'));
    const activeIndexLabel = carousel.querySelector<HTMLElement>('[data-active-index]');
    const activeTitle = carousel.querySelector<HTMLElement>('[data-active-title]');
    const activeDescription = carousel.querySelector<HTMLElement>('[data-active-description]');

    if (slides.length === 0 || controls.length === 0) return;

    // Single source of truth: sectors data mapping
    const sectors = [
      {
        id: 'mineria',
        title: 'Minería Sustentable & Litio',
        description:
          'Extracción responsable, energías para la transición global y la cadena de valor de proveedores locales.',
        image: '/images/sectors/mineria.jpg',
      },
      {
        id: 'agroindustria',
        title: 'Agroindustria con Identidad',
        description:
          'Valor agregado en origen, producción tabacalera, cañera, cooperativas agrícolas y alimentos andinos de exportación.',
        image: '/images/sectors/agroindustria.jpg',
      },
      {
        id: 'tecnologia',
        title: 'Tecnología e Industrias del Conocimiento',
        description:
          'Soluciones digitales, automatización, software y el talento joven jujeño exportando servicios al mundo.',
        image: '/images/sectors/tecnologia.jpg',
      },
      {
        id: 'turismo',
        title: 'Turismo, Gastronomía & Comercio',
        description:
          'Patrimonio cultural, hotelería, servicios esenciales y el entramado comercial que mueve el consumo local.',
        image: '/images/sectors/turismo.jpg',
      },
      {
        id: 'industria-logistica',
        title: 'Industria, Construcción & Logística',
        description:
          'Grandes empresas, manufactura, infraestructura pesada y la red de servicios corporativos de la provincia.',
        image: '/images/sectors/transporteylogistica.jpg',
      },
      {
        id: 'emprendimientos',
        title: 'Emprendimientos & Economía Popular',
        description:
          'Cooperativas artesanales, micro-PyMEs y proyectos emergentes que transforman la capacidad local en desarrollo genuino.',
        image: '/images/sectors/emprendimientos.jpg',
      },
    ];

    let activeIndex = 0;
    let autoplayTimer: ReturnType<typeof setTimeout> | null = null;
    let isPaused = false;
    const AUTOPLAY_DURATION = 5000;

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReducedMotion = motionQuery.matches;

    motionQuery.addEventListener('change', (e) => {
      prefersReducedMotion = e.matches;
      if (prefersReducedMotion) {
        stopAutoplay();
      } else if (!isPaused) {
        startAutoplay();
      }
    });

    function restartProgress() {
      controls.forEach((control, controlIndex) => {
        const progress = control.querySelector<HTMLElement>('.ecosystem-control__progress');
        if (progress) {
          progress.style.animation = 'none';
          void progress.offsetWidth; // Reflow
          if (controlIndex === activeIndex && !prefersReducedMotion) {
            progress.style.animation = '';
          }
        }
      });
    }

    function setActive(index: number, shouldFocus = false) {
      activeIndex = (index + sectors.length) % sectors.length;
      const sector = sectors[activeIndex];

      if (activeIndexLabel) {
        activeIndexLabel.textContent =
          `${String(activeIndex + 1).padStart(2, '0')} / ${String(sectors.length).padStart(2, '0')}`;
      }

      if (activeTitle) activeTitle.textContent = sector.title;
      if (activeDescription) activeDescription.textContent = sector.description;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      controls.forEach((control, controlIndex) => {
        const isActive = controlIndex === activeIndex;
        control.setAttribute('aria-selected', String(isActive));
        control.classList.toggle('is-active', isActive);
        control.setAttribute('tabindex', isActive ? '0' : '-1');

        if (isActive && shouldFocus) {
          control.focus();
        }
      });

      restartProgress();

      if (!prefersReducedMotion && !isPaused) {
        startAutoplay();
      }
    }

    function startAutoplay() {
      stopAutoplay();
      if (prefersReducedMotion) return;
      autoplayTimer = setTimeout(() => {
        if (!isPaused) {
          setActive(activeIndex + 1);
        }
      }, AUTOPLAY_DURATION);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearTimeout(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function pause() {
      isPaused = true;
      carousel?.classList.add('is-paused');
      stopAutoplay();
    }

    function resume() {
      isPaused = false;
      carousel?.classList.remove('is-paused');
      restartProgress();
      startAutoplay();
    }

    // Attach click and keyboard events to controls
    controls.forEach((control, controlIndex) => {
      control.addEventListener('click', (e) => {
        e.preventDefault();
        setActive(controlIndex);
      });

      control.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(activeIndex + 1, true);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(activeIndex - 1, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          setActive(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          setActive(sectors.length - 1, true);
        }
      });
    });

    // Pause on hover
    carousel.addEventListener('mouseenter', pause);
    carousel.addEventListener('mouseleave', resume);

    // Pause on focus
    carousel.addEventListener('focusin', pause);
    carousel.addEventListener('focusout', (e) => {
      const focusEvent = e as FocusEvent;
      if (!carousel.contains(focusEvent.relatedTarget as Node | null)) {
        resume();
      }
    });

    // Initial setup
    setActive(0);
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProgressiveCarousel);
  } else {
    initProgressiveCarousel();
  }

  document.addEventListener('astro:page-load', initProgressiveCarousel);
</script>

