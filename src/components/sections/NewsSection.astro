---
// src/components/sections/NewsSection.astro
// Sección editorial de novedades — 1 destacada + 3 compactas
// Las noticias se reemplazan con contenido institucional confirmado antes de publicar.

const news = [
  {
    id: 'apertura-inscripciones',
    category: 'Inscripciones',
    date: '2026',
    title: 'Abierta la inscripción para expositores de ExpoJuy 2026',
    description:
      'Empresas, cooperativas y emprendimientos de todo el NOA ya pueden reservar su stand en la feria multisectorial más importante de la región.',
    image: '/images/novedades/1-BGVsbHVM.webp',
    href: '#',
  },
  {
    id: 'rondas-b2b',
    category: 'B2B',
    date: '2026',
    title: 'Rondas de negocios con delegaciones internacionales',
    description:
      'El programa B2B conectará a productores locales con compradores de Chile, Paraguay y Brasil a través del Corredor Bioceánico.',
    image: '/images/novedades/3-CBThIh5p.webp',
    href: '#',
  },
  {
    id: 'sede-ciudad-cultural',
    category: 'Sede',
    date: '2026',
    title: 'Ciudad Cultural, sede confirmada del evento',
    description: '',
    image: '/images/novedades/4-Bbx0X9Ik.webp',
    href: '#',
  },
  {
    id: 'sectores-estrategicos',
    category: 'Programa',
    date: '2026',
    title: 'Más de seis sectores productivos en un solo escenario',
    description: '',
    image: '/images/novedades/6-Co0Y9xOQ.webp',
    href: '#',
  },
];

const featured = news[0];
const secondary = news.slice(1);
---

<section
  id="novedades"
  class="news-section section"
  aria-labelledby="news-title"
>
  <div class="container">
    <header class="news-section__heading">
      <div>
        <p class="eyebrow">ACTUALIDAD EXPOJUY</p>
        <h2 id="news-title">Novedades</h2>
      </div>
    </header>

    <div class="news-section__layout">
      <!-- Card destacada -->
      <article class="news-card news-card--featured">
        <div class="news-card__media">
          <img
            src={featured.image}
            alt={featured.title}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="news-card__body">
          <div>
            <div class="news-card__meta">
              <span class="news-card__tag">{featured.category}</span>
              <span>{featured.date}</span>
            </div>
            <h3><span>{featured.title}</span></h3>
            {featured.description && (
              <p class="news-card__description">{featured.description}</p>
            )}
          </div>
          <a href={featured.href} class="news-card__cta" aria-label={`Leer más sobre: ${featured.title}`}>
            Leer más <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <!-- Cards secundarias -->
      <div class="news-section__grid">
        {secondary.map(item => (
          <article class="news-card news-card--compact">
            <div class="news-card__media">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="news-card__body">
              <div class="news-card__meta">
                <span class="news-card__tag">{item.category}</span>
                <span>{item.date}</span>
              </div>
              <h3><span>{item.title}</span></h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Sección Novedades ─────────────────────────────────────── */
  .news-section {
    background: var(--color-page);
  }

  .news-section__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .news-section__heading h2 {
    margin: 8px 0 0;
    color: var(--color-ink);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .news-section__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--theme-primary);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: gap 220ms ease, color 220ms ease;
  }

  .news-section__all:hover {
    gap: 12px;
    color: var(--theme-primary-hover);
  }

  /* ─── Layout editorial: destacada + grilla ──────────────────── */
  .news-section__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: clamp(20px, 3vw, 36px);
    align-items: stretch;
  }

  .news-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  /* ─── Card base ─────────────────────────────────────────────── */
  .news-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    transition:
      transform 260ms ease,
      border-color 260ms ease,
      box-shadow 260ms ease;
  }

  .news-card:hover {
    border-color: var(--theme-primary);
    box-shadow: 0 14px 36px rgb(60 60 59 / 10%);
    transform: translateY(-4px);
  }

  /* ─── Card destacada ────────────────────────────────────────── */
  .news-card--featured {
    display: grid;
    min-height: 410px;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  }

  /* ─── Imagen ────────────────────────────────────────────────── */
  .news-card__media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--theme-tint);
  }

  .news-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card:hover .news-card__media img {
    transform: scale(1.045);
  }

  /* ─── Contenido ─────────────────────────────────────────────── */
  .news-card__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(24px, 3vw, 40px);
  }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-card__tag {
    border-radius: 999px;
    background: var(--theme-tint);
    color: var(--theme-primary);
    padding: 6px 10px;
  }

  .news-card h3 {
    margin: 0 0 14px;
    color: var(--color-ink);
    font-size: clamp(24px, 2.4vw, 38px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .news-card h3 span {
    background-image: linear-gradient(
      var(--theme-primary),
      var(--theme-primary)
    );
    background-position: left bottom;
    background-repeat: no-repeat;
    background-size: 0 2px;
    transition: background-size 450ms ease;
  }

  .news-card:hover h3 span {
    background-size: 100% 2px;
  }

  .news-card__description {
    color: var(--color-ink-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .news-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    color: var(--theme-primary);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .news-card:hover .news-card__cta span {
    transform: translateX(4px);
  }

  .news-card__cta span {
    transition: transform 220ms ease;
  }

  /* ─── Cards compactas ───────────────────────────────────────── */
  .news-card--compact {
    display: grid;
    min-height: 128px;
    grid-template-columns: 150px minmax(0, 1fr);
  }

  .news-card--compact .news-card__media {
    min-height: 128px;
  }

  .news-card--compact .news-card__body {
    padding: 18px 20px;
  }

  .news-card--compact .news-card__meta {
    margin-bottom: 9px;
    font-size: 10px;
  }

  .news-card--compact h3 {
    margin-bottom: 0;
    font-size: 18px;
    line-height: 1.14;
  }

  .news-card--compact .news-card__description,
  .news-card--compact .news-card__cta {
    display: none;
  }

  /* ─── Reduced motion ────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .news-card,
    .news-card__media img,
    .news-card h3 span,
    .news-card__cta span {
      transition: none;
    }

    .news-card:hover {
      transform: none;
    }

    .news-card:hover .news-card__media img {
      transform: none;
    }
  }

  /* ─── Responsive: Tablet ────────────────────────────────────── */
  @media (max-width: 1023px) {
    .news-section__layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .news-card--featured {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .news-card--featured .news-card__media {
      min-height: 280px;
    }

    .news-section__grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .news-section__grid .news-card--compact {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .news-section__grid .news-card--compact .news-card__media {
      min-height: 140px;
    }

    .news-section__grid .news-card--compact .news-card__body {
      padding: 16px;
    }
  }

  /* ─── Responsive: Mobile ────────────────────────────────────── */
  @media (max-width: 767px) {
    .news-section__heading {
      display: block;
    }

    .news-section__all {
      margin-top: 18px;
    }

    .news-section__layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .news-card--featured {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .news-card--featured .news-card__media {
      min-height: 240px;
    }

    .news-section__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .news-card--compact {
      min-height: 116px;
      grid-template-columns: 112px minmax(0, 1fr);
    }

    .news-card--compact .news-card__media {
      min-height: 116px;
    }

    .news-card--compact .news-card__body {
      padding: 14px;
    }

    .news-card--compact h3 {
      font-size: 16px;
    }
  }
</style>
