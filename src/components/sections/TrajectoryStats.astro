---
// src/components/sections/TrajectoryStats.astro
// Desktop: 4-col grid | Mobile: horizontal scroll snap carousel
import SectionHeader from '../ui/SectionHeader.astro';

const stats = [
  {
    value: '17',
    suffix: '.ª',
    label: 'Ediciones',
    sublabel: 'Trayectoria regional consolidada',
    territory: 'text-yungas',
  },
  {
    value: '4',
    suffix: '',
    label: 'Países',
    sublabel: 'AR · CL · PY · BR — Corredor Bioceánico',
    territory: 'text-valles',
  },
  {
    value: '+250',
    suffix: '',
    label: 'Expositores',
    sublabel: 'Industria, minería, agro y tecnología',
    territory: 'text-puna',
  },
  {
    value: '+40K',
    suffix: '',
    label: 'Visitantes',
    sublabel: 'Estimación de afluencia general',
    territory: 'text-quebrada',
  },
];

const latamCountries = [
  { flag: '🇦🇷', name: 'Argentina' },
  { flag: '🇨🇱', name: 'Chile' },
  { flag: '🇧🇷', name: 'Brasil' },
  { flag: '🇵🇾', name: 'Paraguay' },
  { flag: '🇺🇾', name: 'Uruguay' },
  { flag: '🇧🇴', name: 'Bolivia' },
  { flag: '🇵🇪', name: 'Perú' },
];

const marqueeItems = [...latamCountries, ...latamCountries, ...latamCountries];
---

<section
  class="trajectory-future"
  id="trayectoria"
  data-trajectory-section
  aria-labelledby="trajectory-title"
>
  <div class="trajectory-future__scroll-space">
    <div class="trajectory-future__sticky">
      <div class="container trajectory-future__content">
        <div
          class="trajectory-future__heading mb-8 md:mb-10"
          data-trajectory-heading
          id="trajectory-title"
        >
          <SectionHeader
            eyebrow="Trayectoria & Futuro"
            title="La feria que conecta producción, talento y oportunidades."
            lead="ExpoJuy 2026 es la 17.ª edición de la feria multisectorial de Jujuy. Reúne empresas, emprendedores, instituciones y delegaciones internacionales del Corredor Bioceánico."
            territory="yungas"
            class="max-w-2xl"
          />
        </div>

        <div
          class="trajectory-future__stats"
          data-trajectory-stats
          aria-label="Datos destacados de ExpoJuy 2026"
          role="list"
        >
          {stats.map((stat) => (
            <div
              class="trajectory-stat"
              data-trajectory-stat
              role="listitem"
            >
              <div class="flex items-baseline gap-0.5 leading-none mb-2">
                <span class={`stat-value text-display font-extrabold leading-none ${stat.territory}`}>
                  {stat.value}
                </span>
                {stat.suffix && (
                  <span class={`text-h2 font-bold ${stat.territory}`}>
                    {stat.suffix}
                  </span>
                )}
              </div>
              <p class="stat-label text-h3 font-bold text-ink mb-1">{stat.label}</p>
              <p class="stat-sublabel text-small text-ink/70 leading-snug">{stat.sublabel}</p>
            </div>
          ))}
        </div>

        <!-- Franja de banderas LATAM como bajada/transición -->
        <div
          class="trajectory-latam-marquee"
          data-latam-marquee
          tabindex="0"
          aria-label="Países latinoamericanos presentes en el entorno regional de ExpoJuy"
        >
          <div class="trajectory-latam-marquee__track">
            <div class="trajectory-latam-marquee__group">
              {marqueeItems.map((country) => (
                <span class="trajectory-latam-marquee__item">
                  <span aria-hidden="true">{country.flag}</span>
                  <span>{country.name}</span>
                </span>
                <span class="trajectory-latam-marquee__separator" aria-hidden="true">✦</span>
              ))}
            </div>

            <div class="trajectory-latam-marquee__group" aria-hidden="true">
              {marqueeItems.map((country) => (
                <span class="trajectory-latam-marquee__item">
                  <span aria-hidden="true">{country.flag}</span>
                  <span>{country.name}</span>
                </span>
                <span class="trajectory-latam-marquee__separator" aria-hidden="true">✦</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initTrajectory() {
    const section = document.querySelector('[data-trajectory-section]');
    if (!section || section.hasAttribute('data-trajectory-ready')) return;
    section.setAttribute('data-trajectory-ready', 'true');

    const heading = section.querySelector('[data-trajectory-heading]');
    const stats = Array.from(
      section.querySelectorAll('[data-trajectory-stat]')
    );

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (reducedMotion.matches) {
      section.classList.add('is-visible');
      if (heading) heading.classList.add('is-visible');
      stats.forEach((stat) => {
        stat.classList.add('is-revealed');
      });
      return;
    }

    // Set staggered delay
    stats.forEach((stat, index) => {
      stat.style.setProperty('--trajectory-delay', `${index * 90}ms`);
    });

    // Reveal when entering viewport
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        section.classList.add('is-visible');
        if (heading) heading.classList.add('is-visible');
        stats.forEach((stat) => {
          stat.classList.add('is-revealed');
        });
        observer.disconnect();
      },
      { threshold: 0.15 }
    );
    observer.observe(section);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTrajectory);
  } else {
    initTrajectory();
  }
</script>

<style>
  .trajectory-future {
    position: relative;
    background: var(--color-page);
    overflow: hidden;
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: 0;
  }

  .trajectory-future__scroll-space {
    position: relative;
    min-height: auto;
  }

  .trajectory-future__sticky {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    padding-block: 0;
  }

  .trajectory-future__content {
    width: 100%;
  }

  /* ─── Encabezado ────────────────────────────────────────── */
  .trajectory-future__heading {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 800ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .trajectory-future__heading.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── Grilla de Fichas ─────────────────────────────────── */
  .trajectory-future__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    width: 100%;
  }

  /* ─── Fichas Glass ──────────────────────────────────────── */
  .trajectory-stat {
    position: relative;
    overflow: hidden;
    padding: clamp(20px, 2.5vw, 28px);
    border: 1px solid rgb(255 255 255 / 72%);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        rgb(255 255 255 / 72%),
        rgb(255 255 255 / 46%)
      );
    box-shadow:
      0 16px 36px rgb(60 60 59 / 10%),
      inset 0 1px 0 rgb(255 255 255 / 86%),
      inset 0 -1px 0 rgb(60 60 59 / 7%);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    opacity: 0.48;
    transform: translateY(32px) scale(0.97);
    transition:
      opacity 750ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 850ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 500ms ease,
      border-color 500ms ease;
    transition-delay: var(--trajectory-delay, 0ms);
  }

  .trajectory-stat::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background:
      linear-gradient(
        120deg,
        rgb(255 255 255 / 28%),
        transparent 38%,
        transparent 72%,
        rgb(255 255 255 / 8%)
      );
    opacity: 0.55;
  }

  .trajectory-stat.is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
    border-color: color-mix(
      in srgb,
      var(--theme-primary) 22%,
      rgb(255 255 255 / 72%)
    );
    box-shadow:
      0 20px 44px rgb(60 60 59 / 12%),
      inset 0 1px 0 rgb(255 255 255 / 90%),
      inset 0 -1px 0 rgb(60 60 59 / 7%);
  }

  .trajectory-stat:hover {
    transform: translateY(-3px) scale(1.01);
    border-color: var(--theme-primary);
    box-shadow:
      0 22px 48px rgb(60 60 59 / 16%),
      inset 0 1px 0 rgb(255 255 255 / 95%);
  }

  /* ─── Franja de Banderas LATAM ──────────────────────────── */
  .trajectory-latam-marquee {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: clamp(24px, 3vw, 36px);
    margin-bottom: 0;
    overflow: hidden;
    outline: none;
    border-top: 1px solid rgb(60 60 59 / 10%);
    border-bottom: 1px solid rgb(60 60 59 / 10%);
    background:
      linear-gradient(
        135deg,
        rgb(255 255 255 / 68%),
        rgb(230 230 230 / 48%)
      );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 72%),
      inset 0 -1px 0 rgb(60 60 59 / 6%);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
  }

  .trajectory-latam-marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: trajectory-latam-scroll 34s linear infinite;
  }

  .trajectory-latam-marquee__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: clamp(18px, 2.6vw, 36px);
    min-height: 58px;
    padding-right: clamp(18px, 2.6vw, 36px);
  }

  .trajectory-latam-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .trajectory-latam-marquee__item span[aria-hidden='true'] {
    font-size: 20px;
    line-height: 1;
    filter: saturate(0.9);
  }

  .trajectory-latam-marquee__separator {
    color: var(--theme-primary);
    font-size: 11px;
    opacity: 0.7;
    transition: color 400ms ease;
  }

  @keyframes trajectory-latam-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .trajectory-latam-marquee:hover .trajectory-latam-marquee__track,
  .trajectory-latam-marquee:focus-within .trajectory-latam-marquee__track {
    animation-play-state: paused;
  }

  /* ─── Responsive: Tablet ────────────────────────────────── */
  @media (max-width: 1023px) {
    .trajectory-future__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  /* ─── Responsive: Mobile ────────────────────────────────── */
  @media (max-width: 767px) {
    .trajectory-future {
      padding-top: 48px;
    }

    .trajectory-future__sticky {
      position: relative;
      min-height: auto;
      padding-block: 0;
    }

    .trajectory-future__content {
      transform: none !important;
    }

    .trajectory-future__heading {
      opacity: 1;
      transform: none;
    }

    .trajectory-stat {
      opacity: 1;
      transform: none;
      padding: 16px 14px;
      border-radius: 14px;
    }

    .trajectory-future__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .stat-value {
      font-size: clamp(28px, 6.5vw, 36px);
    }

    .stat-label {
      font-size: 15px;
    }

    .stat-sublabel {
      font-size: 11px;
      line-height: 1.35;
    }

    .trajectory-latam-marquee {
      margin-top: 24px;
    }

    .trajectory-latam-marquee__group {
      min-height: 52px;
      gap: 18px;
      padding-right: 18px;
    }

    .trajectory-latam-marquee__item {
      gap: 7px;
      font-size: 11px;
      letter-spacing: 0.07em;
    }

    .trajectory-latam-marquee__item span[aria-hidden='true'] {
      font-size: 18px;
    }

    .trajectory-latam-marquee__track {
      animation-duration: 40s;
    }
  }

  @media (max-width: 420px) {
    .trajectory-future__stats {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  /* ─── Reduced Motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .trajectory-future__heading,
    .trajectory-stat,
    .trajectory-future__content {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .trajectory-future__scroll-space {
      min-height: auto;
    }

    .trajectory-future__sticky {
      position: relative;
      min-height: auto;
    }

    .trajectory-latam-marquee__track {
      animation: none;
    }

    .trajectory-latam-marquee {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }
</style>
