---
// src/components/sections/TrajectoryStats.astro
// Desktop: 4-col grid | Mobile: horizontal scroll snap carousel
import SectionHeader from '../ui/SectionHeader.astro';

const stats = [
  {
    value: '17',
    suffix: '.ª',
    label: 'Ediciones',
    sublabel: 'Trayectoria regional consolidada',
    territory: 'bg-yungas/10 text-yungas',
  },
  {
    value: '4',
    suffix: '',
    label: 'Países',
    sublabel: 'AR · CL · PY · BR — Corredor Bioceánico',
    territory: 'bg-valles/10 text-valles',
  },
  {
    value: '+250',
    suffix: '',
    label: 'Expositores',
    sublabel: 'Industria, minería, agro y tecnología',
    territory: 'bg-puna/10 text-puna',
  },
  {
    value: '+40K',
    suffix: '',
    label: 'Visitantes',
    sublabel: 'Estimación de afluencia general',
    territory: 'bg-quebrada/10 text-quebrada',
  },
];
---

<section class="section bg-white" id="trayectoria" aria-label="Trayectoria y cifras de ExpoJuy">
  <div class="container">
    <SectionHeader
      eyebrow="Trayectoria & Futuro"
      title="La feria que conecta producción, talento y oportunidades."
      lead="ExpoJuy 2026 es la 17.ª edición de la feria multisectorial de Jujuy. Reúne empresas, emprendedores, instituciones y delegaciones internacionales del Corredor Bioceánico."
      territory="yungas"
      class="mb-10 max-w-2xl"
    />

    <!-- Mobile: CSS scroll snap carousel | Desktop: 4-col grid -->
    <div
      class="
        flex overflow-x-auto snap-x-mandatory gap-4 pb-4 scrollbar-none
        md:grid md:grid-cols-2 md:overflow-visible md:snap-none lg:grid-cols-4
      "
      role="list"
      aria-label="Estadísticas del evento"
    >
      {stats.map(stat => (
        <div
          class={`
            snap-start flex-shrink-0 w-[240px] md:w-auto
            ${stat.territory} rounded-lg p-6
            flex flex-col gap-2
          `}
          role="listitem"
        >
          <div class="flex items-baseline gap-0.5 leading-none">
            <span class="text-display font-extrabold leading-none">{stat.value}</span>
            {stat.suffix && <span class="text-h2 font-bold">{stat.suffix}</span>}
          </div>
          <p class="text-h3 font-bold">{stat.label}</p>
          <p class="text-small opacity-70 leading-snug">{stat.sublabel}</p>
        </div>
      ))}
    </div>

    <!-- Scroll hint on mobile -->
    <p class="md:hidden text-center text-caption text-ink/40 mt-2" aria-hidden="true">
      ← Deslizá para ver más →
    </p>
  </div>
</section>
