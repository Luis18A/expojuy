---
// src/components/sections/B2BRounds.astro
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';

const base = import.meta.env.BASE_URL;

const steps = [
  {
    step: '01',
    icon: 'edit_note',
    title: 'Registro y Perfil',
    desc: 'Completá el formulario con la oferta/demanda de tu empresa. Incluye sector, país de origen y objetivos.',
  },
  {
    step: '02',
    icon: 'schema',
    title: 'Matchmaking',
    desc: 'El sistema inteligente cruza intereses y agendá reuniones con contrapartes seleccionadas del Corredor.',
  },
  {
    step: '03',
    icon: 'handshake',
    title: 'Encuentro Presencial',
    desc: 'Reuniones ejecutivas de 30 minutos en el Salón B2B con soporte trilingüe (ES / PT / EN).',
  },
];
---

<section class="section bg-gradient-hero" id="b2b-rounds" aria-label="Rondas de Vinculación B2B">
  <div class="container">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div class="flex flex-col gap-6">
        <div>
          <Badge territory="cyan" class="mb-3">Acreditación Comercial Bioceánica</Badge>
          <h2 class="text-h2 text-white font-bold mt-2">
            Rondas de Vinculación <span class="text-cyan">B2B</span> ExpoJuy 2026
          </h2>
          <p class="text-body-lg text-white/70 mt-3 max-w-lg leading-relaxed">
            Reuniones de negocios programadas uno a uno entre empresas locales, proveedores y delegaciones compradoras de Chile, Paraguay y Brasil.
          </p>
        </div>

        <!-- Chips -->
        <div class="flex flex-wrap gap-2">
          {['Agendamiento Pre-Evento', 'Mesas Sectoriales Exclusivas', 'Soporte Trilingüe', '+60 Compradores Confirmados'].map(chip => (
            <span class="px-3 py-1.5 rounded-pill bg-white/15 text-white text-caption font-semibold border border-white/20">
              {chip}
            </span>
          ))}
        </div>

        <div class="flex flex-wrap gap-3">
          <Button href={`${base}b2b`} variant="inverse" size="lg" icon="arrow_forward">
            Inscribir mi Empresa
          </Button>
          <Button href={`${base}b2b#como-funciona`} variant="outline" size="lg" class="border-white/30 text-white hover:bg-white/10">
            ¿Cómo funcionan?
          </Button>
        </div>
      </div>

      <!-- Steps -->
      <div class="flex flex-col gap-4">
        {steps.map((step, i) => (
          <div class="flex gap-4 items-start bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/15">
            <div class="flex flex-col items-center flex-shrink-0">
              <div class="w-10 h-10 rounded-full bg-cyan/20 border border-cyan/40 text-cyan flex items-center justify-center font-bold text-small">
                {step.step}
              </div>
              {i < steps.length - 1 && (
                <div class="w-0.5 h-6 bg-white/15 mt-2" aria-hidden="true"></div>
              )}
            </div>
            <div class="flex flex-col gap-1 pt-1">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px] text-cyan" aria-hidden="true">{step.icon}</span>
                <p class="text-body font-bold text-white">{step.title}</p>
              </div>
              <p class="text-small text-white/65 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
