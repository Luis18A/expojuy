---

{exhibitors.length > 0 && (
  <section
    class="exhibitor-logos section"
    aria-labelledby="exhibitor-logos-title"
  >
    <div class="container">
      <header class="exhibitor-logos__heading">
        <p class="eyebrow">EMPRESAS PARTICIPANTES</p>
        <h2 id="exhibitor-logos-title">
          Marcas y organizaciones presentes en ExpoJuy 2026
        </h2>
      </header>

      <div
        class="exhibitor-logos__viewport"
        data-exhibitor-logos-carousel
        tabindex="0"
        aria-label="Carrusel de logos de empresas participantes"
      >
        <div class="exhibitor-logos__track">
          <div class="exhibitor-logos__group">
            {exhibitors.map((exhibitor) => (
              <div class="exhibitor-logo">
                <img
                  src={exhibitor.src}
                  alt={exhibitor.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>

          <div class="exhibitor-logos__group" aria-hidden="true">
            {exhibitors.map((exhibitor) => (
              <div class="exhibitor-logo">
                <img
                  src={exhibitor.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .exhibitor-logos {
    position: relative;
    overflow: hidden;
    background: var(--color-page, #f2f2f2);
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 104px);
  }

  .exhibitor-logos__heading {
    max-width: 720px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .eyebrow {
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--theme-primary, #4a1d96);
    margin: 0;
    transition: color 250ms ease;
  }

  .exhibitor-logos__heading h2 {
    max-width: 680px;
    margin: 8px 0 0;
    color: var(--color-ink, #3c3c3b);
    font-family: 'Ambit', system-ui, sans-serif;
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .exhibitor-logos__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    outline: none;
  }

  .exhibitor-logos__viewport::before,
  .exhibitor-logos__viewport::after {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    width: clamp(36px, 8vw, 120px);
    content: '';
    pointer-events: none;
  }

  .exhibitor-logos__viewport::before {
    left: 0;
    background: linear-gradient(
      90deg,
      var(--color-page, #f2f2f2) 0%,
      transparent 100%
    );
  }

  .exhibitor-logos__viewport::after {
    right: 0;
    background: linear-gradient(
      270deg,
      var(--color-page, #f2f2f2) 0%,
      transparent 100%
    );
  }

  .exhibitor-logos__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: exhibitor-logos-marquee 42s linear infinite;
  }

  .exhibitor-logos__group {
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 40px);
    padding-right: clamp(18px, 3vw, 40px);
  }

  .exhibitor-logo {
    display: flex;
    width: clamp(145px, 15vw, 210px);
    height: 92px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 18px 22px;
    border: 1px solid rgb(60 60 59 / 10%);
    border-radius: 10px;
    background: rgb(255 255 255 / 66%);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .exhibitor-logo img {
    display: block;
    width: 100%;
    max-width: 146px;
    max-height: 50px;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(0.92);
    opacity: 0.72;
    transition:
      filter 220ms ease,
      opacity 220ms ease;
  }

  .exhibitor-logo:hover {
    border-color: var(--theme-primary, #4a1d96);
    background: #ffffff;
    transform: translateY(-2px);
  }

  .exhibitor-logo:hover img {
    filter: grayscale(0) contrast(1);
    opacity: 1;
  }

  @keyframes exhibitor-logos-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .exhibitor-logos__viewport:hover .exhibitor-logos__track,
  .exhibitor-logos__viewport:focus-within .exhibitor-logos__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .exhibitor-logos__track {
      animation: none;
    }

    .exhibitor-logos__viewport {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 767px) {
    .exhibitor-logos {
      padding-top: 48px;
      padding-bottom: 72px;
    }

    .exhibitor-logos__heading {
      margin-bottom: 28px;
    }

    .exhibitor-logo {
      width: 138px;
      height: 80px;
      padding: 14px 16px;
      border-radius: 8px;
    }

    .exhibitor-logo img {
      max-width: 106px;
      max-height: 40px;
    }

    .exhibitor-logos__track {
      animation-duration: 48s;
    }
  }
</style>
