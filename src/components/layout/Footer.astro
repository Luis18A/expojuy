---
// src/components/layout/Footer.astro
const base = import.meta.env.BASE_URL;

const quickLinks = [
  { href: base, label: 'Qué es ExpoJuy 2026' },
  { href: `${base}#corredor`, label: 'Corredor Bioceánico' },
  { href: `${base}#sectores`, label: 'Sectores Estratégicos' },
  { href: `${base}b2b`, label: 'Rondas de Negocios B2B' },
  { href: `${base}expositores#stand`, label: 'Reservar un Stand' },
];

const visitorLinks = [
  { href: `${base}agenda`, label: 'Agenda de Actividades' },
  { href: `${base}expositores`, label: 'Directorio de Expositores' },
  { href: `${base}visita#entradas`, label: 'Comprar Entradas y Pases' },
  { href: `${base}visita#mapa`, label: 'Plano del Predio en PDF' },
  { href: `${base}visita#prensa`, label: 'Acreditaciones de Prensa' },
];

const socials = [
  { name: 'Instagram', icon: 'photo_camera', href: 'https://instagram.com' },
  { name: 'Facebook', icon: 'share', href: 'https://facebook.com' },
  { name: 'LinkedIn', icon: 'work', href: 'https://linkedin.com' },
  { name: 'YouTube', icon: 'play_circle', href: 'https://youtube.com' },
];
---

<footer class="bg-white border-t border-ink/10" aria-label="Pie de página">

  <!-- ═══════════════════════════════════════════
       1. CTA BANNER SUPERIOR CON ESLOGAN OFICIAL
       ═══════════════════════════════════════════ -->
  <div class="bg-gradient-to-r from-violet-dark via-purple-700 to-violet-mid text-white relative overflow-hidden">
    <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-white/5 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-40 -top-12 w-48 h-48 rounded-full bg-white/5 pointer-events-none" aria-hidden="true"></div>

    <div class="container py-8 sm:py-10 flex flex-col lg:flex-row items-center justify-between gap-6 relative z-10">
      <div class="text-center lg:text-left space-y-1.5 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-xs border border-white/20 text-xs font-bold uppercase tracking-wider text-white mb-1">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>9 al 12 de Octubre · Ciudad Cultural · Jujuy</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold leading-tight">
          ExpoJuy 2026 — Conectando países, creando oportunidades.
        </h2>
        <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
          Conectá con más de 200 expositores internacionales, rondas B2B y conferencias estratégicas del NOA.
        </p>
      </div>

      <div class="flex flex-wrap gap-3 justify-center flex-shrink-0">
        <a
          href={`${base}visita#entradas`}
          class="inline-flex items-center gap-2 h-10 px-5 rounded-full bg-white text-violet-dark hover:bg-violet-50 font-bold text-xs shadow-md transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-[17px]">confirmation_number</span>
          <span>Comprar Entradas</span>
        </a>
        <a
          href={`${base}b2b`}
          class="inline-flex items-center gap-2 h-10 px-5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/30 font-bold text-xs backdrop-blur-xs transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-[17px]">handshake</span>
          <span>Registrarse en B2B</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       CUERPO PRINCIPAL DEL FOOTER
       ═══════════════════════════════════════════ -->
  <div class="container py-10 lg:py-12 space-y-10">

    <!-- ═══════════════════════════════════════════
         2. BOLETÍN DE NOVEDADES — ANCHO COMPLETO (ARRIBA)
         ═══════════════════════════════════════════ -->
    <div class="p-6 sm:p-8 rounded-2xl bg-paper border border-ink/10 flex flex-col lg:flex-row items-center justify-between gap-6 shadow-2xs">
      <div class="space-y-1 text-center lg:text-left max-w-xl">
        <div class="inline-flex items-center gap-1.5 text-violet-dark text-xs font-bold uppercase tracking-wider mb-0.5">
          <span class="material-symbols-outlined text-[16px]">mail</span>
          <span>Boletín Oficial · ExpoJuy 2026</span>
        </div>
        <h3 class="text-base sm:text-lg font-extrabold text-ink">
          Suscribite para recibir novedades y actualizaciones
        </h3>
        <p class="text-xs text-ink/65 leading-relaxed">
          Mantenete informado sobre la agenda de conferencias, rondas comerciales B2B y avisos del evento en tiempo real.
        </p>
      </div>

      <form class="flex flex-col sm:flex-row items-center gap-2.5 w-full lg:w-auto flex-shrink-0" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte al boletín oficial!'); this.reset();">
        <div class="relative w-full sm:w-80">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-ink/40 text-[18px] pointer-events-none">mail</span>
          <input
            id="footer-newsletter-full-email"
            type="email"
            placeholder="Ingresá tu correo electrónico..."
            required
            class="w-full h-11 pl-10 pr-4 rounded-xl bg-white border border-ink/15 text-xs sm:text-sm font-medium text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all shadow-2xs"
          />
        </div>
        <button
          type="submit"
          class="w-full sm:w-auto h-11 px-6 rounded-xl bg-violet-dark hover:bg-violet-mid text-white text-xs font-bold transition-all shadow-xs active:scale-95 whitespace-nowrap flex items-center justify-center gap-2"
        >
          <span>Suscribirme</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </button>
      </form>
    </div>
    
    <!-- ═══════════════════════════════════════════
         3. GRILLA PRINCIPAL DE ENLACES E INFORMACIÓN INSTITUCIONAL
         ═══════════════════════════════════════════ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-6 border-b border-ink/8">

      <!-- Columna 1: Marca, Ubicación y Contacto Oficial (span 5) -->
      <div class="lg:col-span-5 space-y-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="w-3 h-3 rounded-full bg-violet-dark"></span>
            <span class="font-extrabold text-ink text-lg tracking-tight">EXPOJUY 2026</span>
          </div>
          <p class="text-[10px] font-bold text-violet-dark uppercase tracking-widest">
            Feria Internacional · Norte Argentino & Corredor Bioceánico
          </p>
        </div>

        <p class="text-xs text-ink/65 leading-relaxed max-w-md">
          El encuentro multisectorial más relevante de la región para la industria, minería, litio, agro e innovación tecnológica.
        </p>

        <!-- Contacto Oficial y Ubicación -->
        <div class="space-y-2 pt-1 border-t border-ink/6">
          <div class="flex items-start gap-2 text-xs text-ink/75">
            <span class="material-symbols-outlined text-violet-dark text-[17px] mt-0.5 flex-shrink-0">mail</span>
            <span><strong>Contacto Oficial:</strong> <a href="mailto:contacto@camcomexjujuy.com.ar" class="text-violet-dark hover:underline font-medium">contacto@camcomexjujuy.com.ar</a></span>
          </div>
          <div class="flex items-start gap-2 text-xs text-ink/75">
            <span class="material-symbols-outlined text-violet-dark text-[17px] mt-0.5 flex-shrink-0">location_on</span>
            <span><strong>Ubicación:</strong> San Salvador de Jujuy, Jujuy, Argentina.</span>
          </div>
          <div class="flex items-start gap-2 text-xs text-ink/75">
            <span class="material-symbols-outlined text-violet-dark text-[17px] mt-0.5 flex-shrink-0">schedule</span>
            <span><strong>Horario de Exposición:</strong> 16:00 a 23:00 hs (Todos los días).</span>
          </div>
        </div>

        <!-- Redes Sociales -->
        <div class="pt-1">
          <p class="text-[11px] font-bold text-ink/50 uppercase tracking-wider mb-2">Seguinos en redes</p>
          <div class="flex items-center gap-2">
            {socials.map(s => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Seguinos en ${s.name}`}
                class="w-8.5 h-8.5 rounded-full bg-paper hover:bg-violet-50 text-ink/60 hover:text-violet-dark border border-ink/10 hover:border-violet-200 flex items-center justify-center transition-all shadow-2xs"
              >
                <span class="material-symbols-outlined text-[16px]">{s.icon}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Columna 2: Enlaces La Expo & Negocios (span 3.5) -->
      <div class="lg:col-span-3 space-y-3">
        <p class="text-xs font-extrabold text-ink uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-3 bg-violet-dark rounded-full"></span>
          <span>La Expo & Negocios</span>
        </p>
        <ul class="space-y-2">
          {quickLinks.map(l => (
            <li>
              <a href={l.href} class="text-xs text-ink/65 hover:text-violet-dark font-medium transition-colors inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-[13px] text-ink/30">chevron_right</span>
                <span>{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Información al Visitante & Entidades Institucionales (span 3.5) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="space-y-3">
          <p class="text-xs font-extrabold text-ink uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-3 bg-violet-dark rounded-full"></span>
            <span>Para el Visitante & Prensa</span>
          </p>
          <ul class="space-y-2">
            {visitorLinks.map(l => (
              <li>
                <a href={l.href} class="text-xs text-ink/65 hover:text-violet-dark font-medium transition-colors inline-flex items-center gap-1">
                  <span class="material-symbols-outlined text-[13px] text-ink/30">chevron_right</span>
                  <span>{l.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Marco Institucional (Organiza y Acompañan) -->
        <div class="p-3.5 rounded-xl bg-paper border border-ink/10 space-y-2.5">
          <div>
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-violet-dark flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">domain</span>
              <span>Organiza:</span>
            </p>
            <p class="text-xs font-bold text-ink">
              Cámara de Comercio Exterior de Jujuy <span class="text-ink/60 font-medium">(CamComEx Jujuy)</span>
            </p>
          </div>

          <div class="border-t border-ink/8 pt-2">
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-ink/40 flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">handshake</span>
              <span>Acompañan:</span>
            </p>
            <p class="text-xs text-ink/75 font-medium leading-relaxed">
              Gobierno de la Provincia de Jujuy <span class="text-ink/30">|</span> Municipalidad de San Salvador de Jujuy <span class="text-ink/30">|</span> Consejo Federal de Inversiones (CFI)
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- ═══════════════════════════════════════════
         4. BARRA INFERIOR / COPYRIGHT & ACCESIBILIDAD
         ═══════════════════════════════════════════ -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-xs text-ink/50 text-center sm:text-left">
        <span>© 2026 ExpoJuy. Todos los derechos reservados.</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-ink/60">
        <a href="#" class="hover:text-violet-dark transition-colors">Privacidad</a>
        <span class="text-ink/20">•</span>
        <a href="#" class="hover:text-violet-dark transition-colors">Términos y Condiciones</a>
        <span class="text-ink/20">•</span>
        <a href="#" class="hover:text-violet-dark transition-colors">Declaración de Accesibilidad</a>
      </div>
    </div>

  </div>
</footer>
