---
// src/components/layout/BottomNav.astro
// Mobile-only bottom navigation bar (hidden on md+)
// Inspired by MWC Barcelona mobile UX — thumb zone optimized

interface Props {
  activePage?: 'home' | 'agenda' | 'visita' | 'b2b' | 'expositores';
  locale?: 'es' | 'en';
  lang?: 'es' | 'en';
}

const { activePage = 'home', locale, lang = 'es' } = Astro.props;
const currentLocale = locale || lang;
const base = import.meta.env.BASE_URL;

const items = [
  {
    id: 'home',
    href: base,
    icon: 'home',
    labelEs: 'Inicio',
    labelEn: 'Home',
  },
  {
    id: 'agenda',
    href: `${base}agenda`,
    icon: 'calendar_month',
    labelEs: 'Agenda',
    labelEn: 'Schedule',
  },
  {
    id: 'visita',
    href: `${base}visita`,
    icon: 'confirmation_number',
    labelEs: 'Entradas',
    labelEn: 'Tickets',
  },
  {
    id: 'b2b',
    href: `${base}b2b`,
    icon: 'handshake',
    labelEs: 'B2B',
    labelEn: 'B2B',
  },
];
---

<nav
  class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-xl border-t border-ink/8 pb-safe"
  aria-label="Navegación rápida"
  style="padding-bottom: max(env(safe-area-inset-bottom), 8px);"
>
  <div class="flex items-center h-16">
    {items.map(item => {
      const isActive = item.id === activePage;
      const initialLabel = currentLocale === 'en' ? item.labelEn : item.labelEs;
      return (
        <a
          href={item.href}
          class={[
            'flex-1 flex flex-col items-center justify-center gap-0.5 h-full',
            'transition-colors duration-fast',
            isActive ? 'text-violet-dark' : 'text-ink/40 hover:text-ink/70',
          ].join(' ')}
          aria-label={initialLabel}
          aria-current={isActive ? 'page' : undefined}
          data-bottomnav-item
          data-label-es={item.labelEs}
          data-label-en={item.labelEn}
        >
          <!-- Active indicator pill -->
          <div class={`relative flex flex-col items-center gap-0.5`}>
            {isActive && (
              <div class="absolute -top-1.5 w-6 h-1 bg-violet-dark rounded-full" aria-hidden="true" />
            )}
            <span class="material-symbols-outlined text-[24px] leading-none" aria-hidden="true">{item.icon}</span>
            <span
              class="text-[10px] font-semibold tracking-wide"
              data-bottomnav-label
              data-label-es={item.labelEs}
              data-label-en={item.labelEn}
            >
              {initialLabel}
            </span>
          </div>
        </a>
      );
    })}
  </div>
</nav>

<script>
  function updateBottomNavLanguage(newLang?: string) {
    const lang = newLang || localStorage.getItem('expojuy_lang') || document.documentElement.lang || 'es';
    const isEn = lang === 'en';

    document.querySelectorAll<HTMLElement>('[data-bottomnav-item]').forEach(item => {
      const label = isEn ? item.dataset.labelEn : item.dataset.labelEs;
      if (label) item.setAttribute('aria-label', label);
    });

    document.querySelectorAll<HTMLElement>('[data-bottomnav-label]').forEach(label => {
      const text = isEn ? label.dataset.labelEn : label.dataset.labelEs;
      if (text) label.textContent = text;
    });
  }

  // Escuchar el cambio de idioma emitido por el Header al presionar ES / EN
  window.addEventListener('langchange', (e: any) => {
    updateBottomNavLanguage(e.detail?.lang);
  });

  // Sincronizar cambios entre ventanas / tabs
  window.addEventListener('storage', (e) => {
    if (e.key === 'expojuy_lang') {
      updateBottomNavLanguage(e.newValue || 'es');
    }
  });

  // Inicializar al cargar el DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => updateBottomNavLanguage());
  } else {
    updateBottomNavLanguage();
  }

  document.addEventListener('astro:page-load', () => updateBottomNavLanguage());
</script>
