---
// src/components/ui/TicketModal.astro
---

<!-- Modal de Checkout / Pago Digital ExpoJuy 2026 -->
<div
  id="payment-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 overflow-y-auto bg-ink/75 backdrop-blur-md transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-ticket-title"
>
  <div
    class="relative w-full max-w-xl bg-white rounded-3xl shadow-2xl border border-ink/10 overflow-hidden transform transition-all my-auto animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- Accent Top Bar (Dynamic Gradient) -->
    <div id="modal-accent-bar" class="h-2 w-full bg-gradient-to-r from-violet-dark via-violet-mid to-quebrada transition-all duration-300" />

    <!-- Close Button -->
    <button
      id="close-payment-modal"
      type="button"
      class="absolute top-4 right-4 w-9 h-9 rounded-full bg-paper hover:bg-ink/10 text-ink/70 hover:text-ink flex items-center justify-center transition-colors z-10"
      aria-label="Cerrar modal"
    >
      <span class="material-symbols-outlined text-[20px]" aria-hidden="true">close</span>
    </button>

    <!-- Content Wrapper -->
    <div class="p-6 sm:p-8">

      <!-- PASO 1 & 2: FORMULARIO Y SELECCIÓN DE PAGO -->
      <div id="modal-step-checkout">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-5">
          <div id="modal-icon-bg" class="w-10 h-10 rounded-xl bg-violet-lavender/50 text-violet-dark flex items-center justify-center flex-shrink-0 transition-colors">
            <span class="material-symbols-outlined text-[22px]">confirmation_number</span>
          </div>
          <div>
            <span id="modal-category-eyebrow" class="text-[11px] font-extrabold uppercase tracking-widest text-violet-dark block">
              Acreditación Oficial
            </span>
            <h2 id="modal-ticket-title" class="text-xl font-bold font-display text-ink leading-tight">Comprar Entrada Digital</h2>
          </div>
        </div>

        <!-- Ticket Summary & Package Card -->
        <div class="bg-paper rounded-2xl p-4 sm:p-5 border border-ink/8 mb-5 space-y-3">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span id="selected-ticket-badge" class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-violet-dark text-white">
                Pase Seleccionado
              </span>
              <h3 id="selected-ticket-name" class="text-lg font-bold text-ink mt-1.5 leading-snug">Abono 4 Días ExpoJuy</h3>
              <p id="selected-ticket-detail" class="text-xs text-ink/65 mt-0.5">Acceso ilimitado del 9 al 12 de Octubre</p>
            </div>
            <div class="text-right flex-shrink-0">
              <span id="selected-ticket-unit-price" class="text-xl font-extrabold text-violet-dark block">ARS 50.000</span>
              <span class="text-[11px] text-ink/50 font-medium">Precio unitario</span>
            </div>
          </div>

          <!-- Included Features List (Dynamic) -->
          <div class="border-t border-ink/8 pt-3">
            <p class="text-[11px] font-extrabold text-ink/40 uppercase tracking-widest mb-1.5">Incluye en tu pase:</p>
            <ul id="modal-features-list" class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-ink/75">
              <!-- Rendered via Javascript -->
            </ul>
          </div>

          <!-- Selector de Cantidad -->
          <div class="border-t border-ink/8 pt-3 flex items-center justify-between gap-4">
            <span class="text-xs font-bold text-ink/80">Cantidad de Entradas:</span>
            <div class="flex items-center gap-2 bg-white rounded-xl border border-ink/15 p-1 shadow-2xs">
              <button
                type="button"
                id="btn-qty-minus"
                class="w-7 h-7 rounded-lg bg-paper hover:bg-ink/10 text-ink font-bold flex items-center justify-center transition-colors text-sm"
                aria-label="Restar entrada"
              >-</button>
              <span id="qty-display" class="w-8 text-center text-sm font-extrabold text-ink">1</span>
              <button
                type="button"
                id="btn-qty-plus"
                class="w-7 h-7 rounded-lg bg-paper hover:bg-ink/10 text-ink font-bold flex items-center justify-center transition-colors text-sm"
                aria-label="Sumar entrada"
              >+</button>
            </div>
          </div>
        </div>

        <!-- Formulario del Comprador -->
        <form id="payment-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="buyer-name" class="block text-xs font-bold text-ink/80 mb-1">Nombre y Apellido *</label>
              <input
                type="text"
                id="buyer-name"
                required
                placeholder="Ej. María González"
                class="w-full px-3.5 py-2.5 rounded-xl border border-ink/15 text-sm text-ink focus:outline-none focus:border-violet-mid focus:ring-2 focus:ring-violet-mid/20 transition-all"
              />
            </div>
            <div>
              <label for="buyer-dni" class="block text-xs font-bold text-ink/80 mb-1">DNI / CUIT *</label>
              <input
                type="text"
                id="buyer-dni"
                required
                placeholder="Ej. 34.567.890"
                class="w-full px-3.5 py-2.5 rounded-xl border border-ink/15 text-sm text-ink focus:outline-none focus:border-violet-mid focus:ring-2 focus:ring-violet-mid/20 transition-all"
              />
            </div>
          </div>

          <div>
            <label for="buyer-email" class="block text-xs font-bold text-ink/80 mb-1">Correo Electrónico (donde recibís el QR) *</label>
            <input
              type="email"
              id="buyer-email"
              required
              placeholder="tuemail@ejemplo.com"
              class="w-full px-3.5 py-2.5 rounded-xl border border-ink/15 text-sm text-ink focus:outline-none focus:border-violet-mid focus:ring-2 focus:ring-violet-mid/20 transition-all"
            />
          </div>

          <!-- Selector Método de Pago -->
          <div>
            <label class="block text-xs font-bold text-ink/80 mb-2">Seleccioná tu método de pago</label>
            <div class="grid grid-cols-3 gap-2.5" role="radiogroup">
              <label class="relative flex flex-col items-center justify-center p-3 rounded-xl border-2 border-violet-mid bg-violet-lavender/10 cursor-pointer hover:border-violet-mid transition-all text-center group">
                <input type="radio" name="payment-method" value="mercadopago" checked class="sr-only" />
                <span class="material-symbols-outlined text-[24px] text-violet-dark mb-1">qr_code_2</span>
                <span class="text-xs font-bold text-violet-dark">Mercado Pago</span>
              </label>

              <label class="relative flex flex-col items-center justify-center p-3 rounded-xl border border-ink/15 bg-white cursor-pointer hover:border-violet-mid/60 transition-all text-center group">
                <input type="radio" name="payment-method" value="card" class="sr-only" />
                <span class="material-symbols-outlined text-[24px] text-ink/60 group-hover:text-violet-dark mb-1">credit_card</span>
                <span class="text-xs font-bold text-ink/80">Tarjeta Deb/Cred</span>
              </label>

              <label class="relative flex flex-col items-center justify-center p-3 rounded-xl border border-ink/15 bg-white cursor-pointer hover:border-violet-mid/60 transition-all text-center group">
                <input type="radio" name="payment-method" value="transfer" class="sr-only" />
                <span class="material-symbols-outlined text-[24px] text-ink/60 group-hover:text-violet-dark mb-1">account_balance</span>
                <span class="text-xs font-bold text-ink/80">Transferencia</span>
              </label>
            </div>
          </div>

          <!-- Total Desglosado y Botón de Pago Principal -->
          <div class="pt-2">
            <button
              type="submit"
              id="btn-process-payment"
              class="w-full h-12 rounded-xl bg-violet-dark hover:bg-violet-mid text-white font-bold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 active:scale-[0.99]"
            >
              <span class="material-symbols-outlined text-[20px]">lock</span>
              <span id="btn-payment-text">Pagar ARS 50.000 con Mercado Pago</span>
            </button>
          </div>

          <div class="flex items-center justify-center gap-2 text-[11px] text-ink/50 font-medium">
            <span class="material-symbols-outlined text-[14px]">shield</span>
            <span>Pago seguro con certificación encriptada 256-bit</span>
          </div>
        </form>
      </div>

      <!-- PASO 3: CONFIRMACIÓN Y EMISIÓN DE CREDENCIAL QR -->
      <div id="modal-step-success" class="hidden text-center py-2 space-y-4">
        <div class="w-14 h-14 rounded-full bg-yungas/20 text-yungas-dark border border-yungas/30 flex items-center justify-center mx-auto shadow-inner animate-bounce">
          <span class="material-symbols-outlined text-[32px]">check_circle</span>
        </div>

        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-yungas-dark bg-yungas/10 px-3 py-1 rounded-full">
            ¡Pago Aprobado con Éxito!
          </span>
          <h2 class="text-2xl font-bold font-display text-ink mt-2">Tu Credencial Digital está Lista</h2>
          <p class="text-xs text-ink/60 mt-1 max-w-sm mx-auto">
            Enviamos el comprobante y el acceso a tu correo electrónico. Presentá este QR en molinetes.
          </p>
        </div>

        <!-- Mock Digital Ticket QR Card -->
        <div class="max-w-xs mx-auto bg-gradient-to-b from-paper to-white rounded-2xl border-2 border-violet-mid/20 p-5 shadow-lg relative overflow-hidden text-left">
          <div class="flex items-center justify-between border-b border-ink/8 pb-3 mb-3">
            <div>
              <span class="text-[9px] font-bold tracking-widest uppercase text-violet-dark block">EXPOJUY 2026</span>
              <span id="success-ticket-title" class="text-xs font-extrabold text-ink">Abono 4 Días ExpoJuy</span>
              <span id="success-ticket-qty" class="text-[10px] font-bold text-ink/60 block mt-0.5">1 Entrada(s)</span>
            </div>
            <span id="success-badge-tag" class="text-[10px] font-black px-2 py-0.5 rounded bg-violet-dark text-white">VALIDADO</span>
          </div>

          <div class="flex items-center justify-center my-2 bg-white p-3 rounded-xl border border-ink/10 shadow-inner">
            <!-- Simulated QR Code SVG -->
            <svg viewBox="0 0 100 100" class="w-28 h-28">
              <rect x="0" y="0" width="100" height="100" fill="#ffffff" />
              <!-- Outer Corners -->
              <rect x="10" y="10" width="25" height="25" fill="#3C3C3B" />
              <rect x="15" y="15" width="15" height="15" fill="#ffffff" />
              <rect x="18" y="18" width="9" height="9" fill="#730DD9" />

              <rect x="65" y="10" width="25" height="25" fill="#3C3C3B" />
              <rect x="70" y="15" width="15" height="15" fill="#ffffff" />
              <rect x="73" y="18" width="9" height="9" fill="#730DD9" />

              <rect x="10" y="65" width="25" height="25" fill="#3C3C3B" />
              <rect x="15" y="70" width="15" height="15" fill="#ffffff" />
              <rect x="18" y="73" width="9" height="9" fill="#730DD9" />

              <!-- Random Data Dots -->
              <rect x="42" y="12" width="7" height="7" fill="#3C3C3B" />
              <rect x="52" y="18" width="6" height="6" fill="#730DD9" />
              <rect x="40" y="40" width="20" height="20" fill="#730DD9" rx="3" />
              <rect x="68" y="45" width="8" height="8" fill="#3C3C3B" />
              <rect x="45" y="68" width="12" height="12" fill="#3C3C3B" />
              <rect x="65" y="65" width="10" height="10" fill="#730DD9" />
              <rect x="78" y="78" width="8" height="8" fill="#3C3C3B" />
            </svg>
          </div>

          <div class="space-y-1 text-center">
            <p class="text-[11px] font-mono font-bold text-ink/80">Código: <span id="success-code">EXP2026-9842</span></p>
            <p id="success-buyer-name" class="text-xs font-bold text-violet-dark">María González</p>
            <p id="success-total-paid" class="text-[11px] font-extrabold text-ink">Total Pagado: ARS 50.000</p>
          </div>
        </div>

        <div class="flex gap-3 max-w-xs mx-auto pt-2">
          <button
            type="button"
            id="btn-download-qr"
            class="flex-1 h-10 rounded-xl bg-paper hover:bg-ink/10 border border-ink/15 text-xs font-bold text-ink flex items-center justify-center gap-1.5 transition-colors"
          >
            <span class="material-symbols-outlined text-[16px]">download</span>
            Guardar QR
          </button>
          <button
            type="button"
            id="btn-finish-modal"
            class="flex-1 h-10 rounded-xl bg-violet-dark hover:bg-violet-mid text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-colors"
          >
            Finalizar
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  // Payment Modal Advanced Handling
  const modal = document.getElementById('payment-modal');
  const closeBtn = document.getElementById('close-payment-modal');
  const finishBtn = document.getElementById('btn-finish-modal');
  const paymentForm = document.getElementById('payment-form') as HTMLFormElement | null;
  const processBtn = document.getElementById('btn-process-payment');
  const btnPaymentText = document.getElementById('btn-payment-text');

  const stepCheckout = document.getElementById('modal-step-checkout');
  const stepSuccess = document.getElementById('modal-step-success');

  const ticketNameEl = document.getElementById('selected-ticket-name');
  const ticketDetailEl = document.getElementById('selected-ticket-detail');
  const ticketUnitPriceEl = document.getElementById('selected-ticket-unit-price');
  const ticketBadgeEl = document.getElementById('selected-ticket-badge');
  const modalAccentBar = document.getElementById('modal-accent-bar');
  const modalIconBg = document.getElementById('modal-icon-bg');
  const modalEyebrow = document.getElementById('modal-category-eyebrow');
  const featuresListEl = document.getElementById('modal-features-list');

  const qtyDisplay = document.getElementById('qty-display');
  const btnQtyMinus = document.getElementById('btn-qty-minus');
  const btnQtyPlus = document.getElementById('btn-qty-plus');

  const successTicketTitle = document.getElementById('success-ticket-title');
  const successBuyerName = document.getElementById('success-buyer-name');
  const successCode = document.getElementById('success-code');
  const successTicketQty = document.getElementById('success-ticket-qty');
  const successTotalPaid = document.getElementById('success-total-paid');

  let baseUnitPrice = 50000;
  let currentQuantity = 1;
  let currentFormattedPrice = 'ARS 50.000';
  let currentSelectedMethod = 'mercadopago';

  function formatARS(amount: number) {
    return 'ARS ' + amount.toLocaleString('es-AR');
  }

  function updateTotalCalculation() {
    const totalAmount = baseUnitPrice * currentQuantity;
    const formattedTotal = formatARS(totalAmount);

    if (qtyDisplay) qtyDisplay.textContent = String(currentQuantity);
    if (ticketUnitPriceEl) ticketUnitPriceEl.textContent = formattedTotal;

    if (btnPaymentText) {
      if (currentSelectedMethod === 'mercadopago') {
        btnPaymentText.textContent = `Pagar ${formattedTotal} con Mercado Pago`;
      } else if (currentSelectedMethod === 'card') {
        btnPaymentText.textContent = `Pagar ${formattedTotal} con Tarjeta`;
      } else {
        btnPaymentText.textContent = `Generar CBU para ${formattedTotal}`;
      }
    }
  }

  btnQtyMinus?.addEventListener('click', () => {
    if (currentQuantity > 1) {
      currentQuantity--;
      updateTotalCalculation();
    }
  });

  btnQtyPlus?.addEventListener('click', () => {
    if (currentQuantity < 10) {
      currentQuantity++;
      updateTotalCalculation();
    }
  });

  function openPaymentModal(ticketData: {
    title: string;
    price: string;
    numprice?: number;
    detail: string;
    badge: string;
    territory?: string;
    features?: string[];
  }) {
    if (!modal) return;

    currentQuantity = 1;
    baseUnitPrice = ticketData.numprice || parseInt(ticketData.price.replace(/[^\d]/g, ''), 10) || 50000;

    if (ticketNameEl) ticketNameEl.textContent = ticketData.title;
    if (ticketDetailEl) ticketDetailEl.textContent = ticketData.detail;
    if (ticketBadgeEl) ticketBadgeEl.textContent = ticketData.badge;
    if (modalEyebrow) modalEyebrow.textContent = `Acreditación · ${ticketData.badge}`;

    // Apply Territory Theme Styling
    const territory = ticketData.territory || 'quebrada';
    if (modalAccentBar) {
      if (territory === 'valles') {
        modalAccentBar.className = 'h-2 w-full bg-gradient-to-r from-valles via-valles-mid to-cyan-500 transition-all duration-300';
      } else if (territory === 'yungas') {
        modalAccentBar.className = 'h-2 w-full bg-gradient-to-r from-yungas via-yungas-mid to-yungas-dark transition-all duration-300';
      } else if (territory === 'puna') {
        modalAccentBar.className = 'h-2 w-full bg-gradient-to-r from-puna via-purple-600 to-puna-dark transition-all duration-300';
      } else {
        modalAccentBar.className = 'h-2 w-full bg-gradient-to-r from-violet-dark via-purple-600 to-quebrada transition-all duration-300';
      }
    }

    // Render Features List
    if (featuresListEl) {
      featuresListEl.innerHTML = '';
      const features = ticketData.features || ['Acceso digital intransferible con QR', 'Ingreso por molinete ferial'];
      features.forEach((feat) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-1.5 font-medium';
        li.innerHTML = `<span class="material-symbols-outlined text-[15px] text-violet-mid">check_circle</span><span>${feat}</span>`;
        featuresListEl.appendChild(li);
      });
    }

    updateTotalCalculation();

    stepCheckout?.classList.remove('hidden');
    stepSuccess?.classList.add('hidden');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closePaymentModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closePaymentModal);
  finishBtn?.addEventListener('click', closePaymentModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePaymentModal();
  });

  // Radio button payment method dynamic text
  document.querySelectorAll('input[name="payment-method"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      currentSelectedMethod = (e.target as HTMLInputElement).value;
      updateTotalCalculation();
    });
  });

  // Handle Submit Form
  paymentForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const buyerNameInput = document.getElementById('buyer-name') as HTMLInputElement;
    const nameVal = buyerNameInput?.value || 'María González';
    const totalAmount = baseUnitPrice * currentQuantity;
    const formattedTotal = formatARS(totalAmount);

    if (processBtn) {
      processBtn.setAttribute('disabled', 'true');
      processBtn.innerHTML = `<span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span> Procesando pago seguro...`;
    }

    // Simulate fast 1.2s gateway processing
    setTimeout(() => {
      if (processBtn) {
        processBtn.removeAttribute('disabled');
        processBtn.innerHTML = `<span class="material-symbols-outlined text-[20px]">lock</span> <span id="btn-payment-text">Pagar ${formattedTotal}</span>`;
      }

      if (successBuyerName) successBuyerName.textContent = nameVal;
      if (successTicketTitle && ticketNameEl) successTicketTitle.textContent = ticketNameEl.textContent;
      if (successTicketQty) successTicketQty.textContent = `${currentQuantity} Entrada(s)`;
      if (successTotalPaid) successTotalPaid.textContent = `Total Pagado: ${formattedTotal}`;
      if (successCode) successCode.textContent = `EXP2026-${Math.floor(1000 + Math.random() * 9000)}`;

      stepCheckout?.classList.add('hidden');
      stepSuccess?.classList.remove('hidden');
    }, 1200);
  });

  // Download QR simulation
  document.getElementById('btn-download-qr')?.addEventListener('click', () => {
    alert('¡Credencial QR descargada! También enviamos una copia a tu correo electrónico.');
  });

  // Expose function globally so any ticket button can open it
  (window as any).openExpoJuyPayment = openPaymentModal;

  // Delegate click events for all elements with class .buy-ticket-btn
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.buy-ticket-btn');
    if (target) {
      e.preventDefault();
      const title = target.getAttribute('data-ticket-title') || 'Abono 4 Días ExpoJuy';
      const price = target.getAttribute('data-ticket-price') || 'ARS 50.000';
      const numpriceStr = target.getAttribute('data-ticket-numprice');
      const numprice = numpriceStr ? parseInt(numpriceStr, 10) : undefined;
      const detail = target.getAttribute('data-ticket-detail') || 'Acceso ilimitado del 9 al 12 oct.';
      const badge = target.getAttribute('data-ticket-badge') || 'Pase Oficial';
      const territory = target.getAttribute('data-ticket-territory') || 'quebrada';
      
      let features: string[] | undefined = undefined;
      const featuresRaw = target.getAttribute('data-ticket-features');
      if (featuresRaw) {
        try {
          features = JSON.parse(featuresRaw);
        } catch (err) {}
      }

      openPaymentModal({ title, price, numprice, detail, badge, territory, features });
    }
  });
</script>
