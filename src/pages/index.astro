---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import Hero from '../components/sections/Hero.astro';
import ExperienceCards from '../components/sections/ExperienceCards.astro';
import TrajectoryStats from '../components/sections/TrajectoryStats.astro';
import StrategicSectors from '../components/sections/StrategicSectors.astro';
import ExhibitorLogosCarousel from '../components/sections/ExhibitorLogosCarousel.astro';
import NewsSection from '../components/sections/NewsSection.astro';
import B2BRounds from '../components/sections/B2BRounds.astro';
import SponsorsCarousel from '../components/sections/SponsorsCarousel.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="ExpoJuy 2026 — Feria Multisectorial del NOA y Corredor Bioceánico"
  description="ExpoJuy 2026 conecta el talento, la industria y el trabajo de Jujuy con el Corredor Bioceánico e inversores internacionales. 9 al 12 de Octubre en Ciudad Cultural."
>
  <Header activePage="home" />
  <BottomNav activePage="home" />

  <main id="main-content">
    <Hero />
    <ExperienceCards />
    <TrajectoryStats />
    <StrategicSectors />
    <ExhibitorLogosCarousel />
    <NewsSection />
    <B2BRounds />

    <!-- Quick access section -->
    <section class="section bg-paper" aria-label="Accesos rápidos">
      <div class="container">
        <p class="eyebrow text-center mb-6">Accesos Rápidos</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { href: `${base}agenda`, icon: 'calendar_month', label: 'Ver Agenda', color: 'bg-yungas/10 text-yungas' },
            { href: `${base}expositores`, icon: 'store', label: 'Expositores', color: 'bg-valles/10 text-valles' },
            { href: `${base}visita#mapa`, icon: 'map', label: 'Plano del Predio', color: 'bg-puna/10 text-puna' },
            { href: `${base}visita`, icon: 'confirmation_number', label: 'Comprar Entradas', color: 'bg-quebrada/10 text-quebrada' },
          ].map(item => (
            <a
              href={item.href}
              class={`flex flex-col items-center gap-3 p-6 rounded-md border border-ink/8 bg-white hover:shadow-md hover:-translate-y-0.5 transition-all group text-center`}
            >
              <div class={`w-12 h-12 rounded-lg flex items-center justify-center ${item.color}`}>
                <span class="material-symbols-outlined text-[24px]" aria-hidden="true">{item.icon}</span>
              </div>
              <span class="text-small font-semibold text-ink group-hover:text-violet-dark transition-colors">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Impact Quote (design.md section 4) -->
    <section class="section bg-ink" aria-label="Cita institucional">
      <div class="container max-w-3xl text-center">
        <blockquote>
          <p class="text-h2 font-bold text-white leading-snug">
            &ldquo;Conectando países, creando oportunidades en el corazón del
            <span class="gradient-text">Corredor Bioceánico y el Triángulo del Litio.</span>&rdquo;
          </p>
          <footer class="mt-6 text-small text-white/40 uppercase tracking-widest">ExpoJuy 2026 · 9-12 de Octubre · Ciudad Cultural, Jujuy</footer>
        </blockquote>
      </div>
    </section>

    <SponsorsCarousel />
  </main>

  <Footer />
</BaseLayout>
