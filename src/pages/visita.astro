---
// src/pages/visita.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';

const base = import.meta.env.BASE_URL;

const tickets = [
  {
    id: 'general',
    badge: 'Público General',
    territory: 'valles' as const,
    price: 'Gratuito',
    subtitle: 'Acceso general los 4 días',
    features: [
      'Acceso a todos los pabellones expositivos',
      'Espectáculos culturales y gastronómicos',
      'Charlas abiertas al público',
      'Mapa interactivo del predio',
    ],
    cta: 'Reservar entrada gratuita',
  },
  {
    id: 'profesional',
    badge: 'Pase Profesional',
    territory: 'yungas' as const,
    price: '$5.000',
    subtitle: 'Por persona · 4 días',
    featured: true,
    features: [
      'Todo lo incluido en General',
      'Acceso prioritario a conferencias',
      'Networking Area Exclusiva',
      'Credencial de Profesional del Sector',
      'Café y cowork en el predio',
    ],
    cta: 'Adquirir Pase Profesional',
  },
  {
    id: 'vip',
    badge: 'Acceso VIP / B2B',
    territory: 'puna' as const,
    price: '$15.000',
    subtitle: 'Por persona · 4 días',
    features: [
      'Todo lo incluido en Profesional',
      'Inscripción a Rondas B2B incluida',
      'Salón de reuniones reservado',
      'Parking exclusivo en el predio',
      'Kits institucionales y merchandising',
    ],
    cta: 'Adquirir Pase VIP',
  },
];

const faq = [
  { q: '¿Cómo llego a Ciudad Cultural?', a: 'Ciudad Cultural Jujuy está ubicada en Av. Bolivia s/n, a 10 minutos del centro. Hay servicio de transporte público frecuente y estacionamiento en el predio para vehículos particulares.' },
  { q: '¿Necesito una entrada para ingresar?', a: 'El ingreso al sector de exposición general es libre y gratuito. Algunos eventos especiales y las Rondas B2B requieren inscripción previa.' },
  { q: '¿Hay acreditación de prensa?', a: 'Sí. Periodistas y medios acreditados tienen acceso especial. Completá el formulario de prensa con 15 días de antelación enviando tu credencial al área de comunicación.' },
  { q: '¿Se puede asistir solo un día?', a: 'Sí. La entrada gratuita permite asistir cualquier día entre el 9 y el 12 de octubre. Los Pases Profesional y VIP son válidos durante los 4 días.' },
  { q: '¿Hay estacionamiento?', a: 'Ciudad Cultural cuenta con playa de estacionamiento gratuita con capacidad limitada. Se recomienda transporte público o los shuttles habilitados desde el centro de la ciudad.' },
];
---

<BaseLayout
  title="Entradas, Plano y Cómo Visitar ExpoJuy 2026"
  description="Conseguí tu entrada, conocé el plano del predio, cómo llegar y la información práctica para visitar ExpoJuy 2026 en Ciudad Cultural, Jujuy."
>
  <Header />
  <BottomNav activePage="visita" />

  <main id="main-content">
    <!-- Page header -->
    <section class="section bg-white border-b border-ink/8">
      <div class="container">
        <nav aria-label="Ruta de navegación" class="flex items-center gap-2 text-caption text-ink/50 mb-6">
          <a href={base} class="hover:text-violet-dark transition-colors">Inicio</a>
          <span aria-hidden="true">/</span>
          <span class="text-ink font-semibold">Visitá ExpoJuy</span>
        </nav>
        <SectionHeader
          eyebrow="Información Práctica"
          title="Todo lo que necesitás para visitar ExpoJuy."
          lead="Entradas, plano del predio, cómo llegar y preguntas frecuentes. Planificá tu visita a la feria multisectorial del Norte Grande."
          territory="valles"
        />
      </div>
    </section>

    <!-- Tickets -->
    <section class="section bg-paper" id="entradas" aria-label="Tipos de entrada">
      <div class="container">
        <SectionHeader
          eyebrow="Entradas & Pases"
          title="Elegí el acceso que se adapta a vos."
          align="center"
          territory="quebrada"
          class="mb-10"
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {tickets.map(ticket => (
            <Card
              territory={ticket.territory}
              class={ticket.featured ? 'ring-2 ring-violet-mid ring-offset-2' : ''}
            >
              <div class="flex flex-col h-full p-6 gap-4">
                <div class="flex items-start justify-between">
                  <Badge territory={ticket.territory}>{ticket.badge}</Badge>
                  {ticket.featured && <span class="text-caption font-bold text-violet-mid">★ Recomendado</span>}
                </div>

                <div>
                  <p class="text-display-sm font-extrabold text-ink leading-none">{ticket.price}</p>
                  <p class="text-small text-ink/50 mt-1">{ticket.subtitle}</p>
                </div>

                <ul class="flex flex-col gap-2 flex-1" role="list">
                  {ticket.features.map(f => (
                    <li class="flex items-start gap-2 text-small text-ink/70" role="listitem">
                      <span class="material-symbols-outlined text-[16px] text-valles mt-0.5 flex-shrink-0" aria-hidden="true">check_circle</span>
                      {f}
                    </li>
                  ))}
                </ul>

                <Button
                  href={ticket.id === 'vip' ? `${base}b2b#registro` : '#'}
                  variant={ticket.featured ? 'primary' : 'outline'}
                  class="w-full justify-center"
                  icon="confirmation_number"
                >
                  {ticket.cta}
                </Button>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Map section -->
    <section class="section bg-white" id="mapa" aria-label="Plano del predio">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
          <SectionHeader
            eyebrow="Ciudad Cultural · Jujuy"
            title="Plano del predio ferial."
            lead="El evento se realiza en Ciudad Cultural Jujuy, Av. Bolivia s/n. Sectorizá tu recorrido y ubicá expositores por pabellón."
            territory="valles"
          />

          <!-- SVG map placeholder -->
          <div
            class="rounded-lg overflow-hidden border border-ink/8 bg-paper aspect-[4/3] flex items-center justify-center relative"
            aria-label="Plano del predio Ciudad Cultural (representación esquemática)"
          >
            <svg viewBox="0 0 400 300" class="w-full h-full" role="img" aria-label="Mapa esquemático del predio">
              <title>Plano esquemático del predio ExpoJuy 2026</title>
              <!-- Outline -->
              <rect x="20" y="20" width="360" height="260" rx="12" fill="#f2f2f2" stroke="#E0E0E0" stroke-width="1.5"/>
              <!-- Pabellón A -->
              <rect x="40" y="50" width="140" height="80" rx="6" fill="#0C619620" stroke="#0C6196" stroke-width="1"/>
              <text x="110" y="86" text-anchor="middle" fill="#0C6196" font-size="12" font-weight="700">PABELLÓN A</text>
              <text x="110" y="102" text-anchor="middle" fill="#0C619680" font-size="9">Minería · Energía</text>
              <!-- Pabellón B -->
              <rect x="220" y="50" width="140" height="80" rx="6" fill="#25C0D420" stroke="#25C0D4" stroke-width="1"/>
              <text x="290" y="86" text-anchor="middle" fill="#005539" font-size="12" font-weight="700">PABELLÓN B</text>
              <text x="290" y="102" text-anchor="middle" fill="#00553980" font-size="9">Agro · Industria</text>
              <!-- Pabellón C (Tecnología) -->
              <rect x="40" y="150" width="100" height="70" rx="6" fill="#820CD020" stroke="#820CD0" stroke-width="1"/>
              <text x="90" y="183" text-anchor="middle" fill="#820CD0" font-size="11" font-weight="700">PAB. C</text>
              <text x="90" y="198" text-anchor="middle" fill="#820CD080" font-size="9">Tech</text>
              <!-- Auditorio -->
              <rect x="160" y="150" width="90" height="70" rx="6" fill="#7553F220" stroke="#7553F2" stroke-width="1"/>
              <text x="205" y="183" text-anchor="middle" fill="#7553F2" font-size="10" font-weight="700">AUDITORIO</text>
              <!-- Salón B2B -->
              <rect x="270" y="150" width="90" height="70" rx="6" fill="#730DD920" stroke="#730DD9" stroke-width="1"/>
              <text x="315" y="183" text-anchor="middle" fill="#730DD9" font-size="10" font-weight="700">SALÓN B2B</text>
              <!-- Pasillo central -->
              <rect x="190" y="140" width="20" height="100" rx="3" fill="#E0E0E0"/>
              <text x="200" y="180" text-anchor="middle" fill="#999" font-size="7" transform="rotate(-90,200,185)">PASILLO</text>
              <!-- Acceso principal -->
              <rect x="140" y="260" width="120" height="16" rx="3" fill="#730DD940"/>
              <text x="200" y="272" text-anchor="middle" fill="#730DD9" font-size="9" font-weight="600">↑ ACCESO PRINCIPAL</text>
              <!-- Leyenda -->
              <text x="200" y="30" text-anchor="middle" fill="#3C3C3B" font-size="10" font-weight="500">Plano orientativo — Ciudad Cultural Jujuy</text>
            </svg>
          </div>
        </div>

        <!-- How to get there -->
        <div class="grid sm:grid-cols-3 gap-4 mt-10">
          {[
            { icon: 'directions_bus', title: 'Transporte público', desc: 'Líneas 16, 19 y 24 desde el centro. Frecuencia cada 15 min durante el evento.' },
            { icon: 'directions_car', title: 'Vehículo propio', desc: 'Estacionamiento gratuito en el predio. Capacidad limitada. Se recomienda llegar temprano.' },
            { icon: 'directions_walk', title: 'Shuttle oficial', desc: 'Servicio gratuito desde Terminal de Ómnibus y Plaza Belgrano. Horario extendido.' },
          ].map(item => (
            <div class="flex items-start gap-4 bg-paper rounded-md p-4 border border-ink/8">
              <div class="w-10 h-10 rounded-md bg-valles/10 text-valles flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">{item.icon}</span>
              </div>
              <div>
                <p class="text-small font-bold text-ink">{item.title}</p>
                <p class="text-caption text-ink/60 leading-relaxed mt-0.5">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section bg-paper" id="faq" aria-label="Preguntas frecuentes">
      <div class="container max-w-2xl">
        <SectionHeader
          eyebrow="FAQS"
          title="Preguntas frecuentes."
          territory="violet"
          align="center"
          class="mb-8"
        />

        <div class="flex flex-col gap-3" role="list">
          {faq.map((item, i) => (
            <details
              class="bg-white rounded-md border border-ink/8 group"
              role="listitem"
            >
              <summary
                class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold text-body text-ink list-none hover:text-violet-dark transition-colors"
                aria-expanded="false"
              >
                <span class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-violet-lavender/30 text-violet-mid text-caption font-bold flex items-center justify-center flex-shrink-0">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {item.q}
                </span>
                <span class="material-symbols-outlined text-ink/30 group-open:rotate-180 transition-transform flex-shrink-0" aria-hidden="true">
                  expand_more
                </span>
              </summary>
              <div class="px-5 pb-5 pt-0">
                <p class="text-small text-ink/65 leading-relaxed pl-9">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
