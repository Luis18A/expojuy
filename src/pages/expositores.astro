              placeholder="Ej: Minera del Norte S.A."
              class="w-full h-10 px-3.5 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-caption font-bold text-ink mb-1">Nombre de Contacto *</label>
              <input
                type="text"
                required
                placeholder="Ej: Juan Pérez"
                class="w-full h-10 px-3.5 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all"
              />
            </div>
            <div>
              <label class="block text-caption font-bold text-ink mb-1">WhatsApp / Teléfono *</label>
              <input
                type="tel"
                required
                placeholder="Ej: +54 388 4000000"
                class="w-full h-10 px-3.5 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all"
              />
            </div>
          </div>

          <div>
            <label class="block text-caption font-bold text-ink mb-1">Correo Electrónico Corporativo *</label>
            <input
              type="email"
              required
              placeholder="contacto@empresa.com"
              class="w-full h-10 px-3.5 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-caption font-bold text-ink mb-1">Sector Productivo</label>
              <select class="w-full h-10 px-3.5 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all">
                <option value="mineria">Minería & Litio</option>
                <option value="agro">Agroindustria & Alimentos</option>
                <option value="construccion">Construcción & Industria</option>
                <option value="tecnologia">Tecnología & Servicios</option>
                <option value="turismo">Turismo & Cultura</option>
                <option value="otro">Otro sector</option>
              </select>
            </div>
            <div>
              <label class="block text-caption font-bold text-ink mb-1">Pabellón de Interés</label>
              <select class="w-full h-10 px-3.5 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all">
                <option value="pabellon-a">Pabellón A (Minería)</option>
                <option value="pabellon-b">Pabellón B (Valles & Comercio)</option>
                <option value="pabellon-c">Pabellón C (Servicios & IT)</option>
                <option value="area-exterior">Área Exterior</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-caption font-bold text-ink mb-1">Superficie estimada o consulta (opcional)</label>
            <textarea
              rows="2"
              placeholder="Ej: Requerimos un stand modular de 12 m²..."
              class="w-full p-3 rounded-xl bg-paper border border-ink/12 text-small text-ink focus:outline-none focus:ring-2 focus:ring-violet-dark/20 focus:border-violet-dark transition-all"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 w-full pt-2">
            <button
              id="exhibitor-modal-cancel"
              type="button"
              class="w-full sm:w-1/2 h-11 px-5 rounded-pill border-2 border-ink/20 text-ink/80 hover:bg-paper font-semibold transition-all text-small"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="w-full sm:w-1/2 h-11 px-5 rounded-pill bg-violet-dark text-white hover:bg-violet-mid font-semibold flex items-center justify-center gap-2 shadow-violet transition-all text-small"
            >
              <span>Enviar Solicitud</span>
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">send</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  // DOM Elements
  const searchInput = document.getElementById('search-expositores') as HTMLInputElement;
  const sectorPills = document.querySelectorAll('.filter-sector-pill');
  const selectOrigin = document.getElementById('select-origin') as HTMLSelectElement;
  const selectPavilion = document.getElementById('select-pavilion') as HTMLSelectElement;
  const btnClearFilters = document.getElementById('btn-clear-filters');
  const btnResetEmpty = document.getElementById('btn-reset-empty');
  const counterCount = document.getElementById('counter-count');

  const btnViewGrid = document.getElementById('btn-view-grid');
  const btnViewList = document.getElementById('btn-view-list');
  const exhibitorsContainer = document.getElementById('exhibitors-container');

  const cards = document.querySelectorAll('.exhibitor-card');
  const emptyState = document.getElementById('empty-state');
  const btnDownloadPdfHeader = document.getElementById('btn-download-pdf-header');

  let activeSector = 'Todos';

  // Filter function
  function applyFilters() {
    const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const selectedOrigin = selectOrigin ? selectOrigin.value : 'Todo Origen';
    const selectedPavilion = selectPavilion ? selectPavilion.value : 'Todos los Pabellones';

    let visibleCount = 0;

    cards.forEach(card => {
      const el = card as HTMLElement;
      const sector = el.dataset.sector || '';
      const origin = el.dataset.origin || '';
      const pavilion = el.dataset.pavilion || '';
      const name = el.dataset.name || '';
      const desc = el.dataset.desc || '';
      const stand = (el.dataset.stand || '').toLowerCase();

      // Matches
      const matchSearch = !q || name.includes(q) || desc.includes(q) || sector.toLowerCase().includes(q) || stand.includes(q);
      const matchSector = activeSector === 'Todos' || sector === activeSector;
      const matchOrigin = selectedOrigin === 'Todo Origen' || origin === selectedOrigin;
      const matchPavilion = selectedPavilion === 'Todos los Pabellones' || pavilion === selectedPavilion;

      if (matchSearch && matchSector && matchOrigin && matchPavilion) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (counterCount) {
      counterCount.textContent = visibleCount.toString();
    }

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  }

  // Sector pill click
  sectorPills.forEach(pill => {
    pill.addEventListener('click', () => {
      const targetSector = pill.getAttribute('data-sector') || 'Todos';
      activeSector = targetSector;

      sectorPills.forEach(p => {
        const isCurrent = p.getAttribute('data-sector') === targetSector;
        p.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');

        p.classList.toggle('bg-violet-dark', isCurrent);
        p.classList.toggle('text-white', isCurrent);
        p.classList.toggle('border-violet-dark', isCurrent);
        p.classList.toggle('font-bold', isCurrent);
        p.classList.toggle('shadow-xs', isCurrent);

        p.classList.toggle('bg-paper', !isCurrent);
        p.classList.toggle('text-ink/75', !isCurrent);
        p.classList.toggle('border-ink/12', !isCurrent);
        p.classList.toggle('font-semibold', !isCurrent);
      });

      applyFilters();
    });
  });

  // Search input change
  searchInput?.addEventListener('input', applyFilters);

  // Dropdown changes
  selectOrigin?.addEventListener('change', applyFilters);
  selectPavilion?.addEventListener('change', applyFilters);

  // Clear filters button
  function resetAllFilters() {
    if (searchInput) searchInput.value = '';
    if (selectOrigin) selectOrigin.value = 'Todo Origen';
    if (selectPavilion) selectPavilion.value = 'Todos los Pabellones';
    activeSector = 'Todos';

    sectorPills.forEach((p, i) => {
      const isCurrent = i === 0;
      p.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');

      p.classList.toggle('bg-violet-dark', isCurrent);
      p.classList.toggle('text-white', isCurrent);
      p.classList.toggle('border-violet-dark', isCurrent);
      p.classList.toggle('font-bold', isCurrent);
      p.classList.toggle('shadow-xs', isCurrent);

      p.classList.toggle('bg-paper', !isCurrent);
      p.classList.toggle('text-ink/75', !isCurrent);
      p.classList.toggle('border-ink/12', !isCurrent);
      p.classList.toggle('font-semibold', !isCurrent);
    });

    applyFilters();
  }

  btnClearFilters?.addEventListener('click', resetAllFilters);
  btnResetEmpty?.addEventListener('click', resetAllFilters);

  // View switch (Grid vs List)
  btnViewGrid?.addEventListener('click', () => {
    exhibitorsContainer?.classList.remove('grid-cols-1');
    exhibitorsContainer?.classList.add('sm:grid-cols-2', 'md:grid-cols-3', 'xl:grid-cols-4');

    btnViewGrid.classList.add('bg-violet-dark', 'text-white');
    btnViewGrid.classList.remove('text-ink/60');
    btnViewList?.classList.remove('bg-violet-dark', 'text-white');
    btnViewList?.classList.add('text-ink/60');
  });

  btnViewList?.addEventListener('click', () => {
    exhibitorsContainer?.classList.remove('sm:grid-cols-2', 'md:grid-cols-3', 'xl:grid-cols-4');
    exhibitorsContainer?.classList.add('grid-cols-1');

    btnViewList.classList.add('bg-violet-dark', 'text-white');
    btnViewList.classList.remove('text-ink/60');
    btnViewGrid?.classList.remove('bg-violet-dark', 'text-white');
    btnViewGrid?.classList.add('text-ink/60');
  });

  // PDF Map Download
  btnDownloadPdfHeader?.addEventListener('click', () => {
    window.print();
  });

  // Sector Scroll Buttons (Left / Right)
  const sectorsScrollContainer = document.getElementById('sectors-scroll-container');
  const btnScrollSectorsLeft = document.getElementById('btn-scroll-sectors-left');
  const btnScrollSectorsRight = document.getElementById('btn-scroll-sectors-right');

  btnScrollSectorsLeft?.addEventListener('click', () => {
    sectorsScrollContainer?.scrollBy({ left: -200, behavior: 'smooth' });
  });

  btnScrollSectorsRight?.addEventListener('click', () => {
    sectorsScrollContainer?.scrollBy({ left: 200, behavior: 'smooth' });
  });

  // Modal Solicitud de Stand Expositores
  const modal = document.getElementById('exhibitor-modal');
  const modalContainer = document.getElementById('exhibitor-modal-card');
  const openBtns = document.querySelectorAll('.btn-open-exhibitor-modal');
  const cancelBtn = document.getElementById('exhibitor-modal-cancel');
  const closeX = document.getElementById('exhibitor-modal-close-x');
  const exhibitorForm = document.getElementById('exhibitor-request-form');

  function openModal(e?: Event) {
    if (e) e.preventDefault();
    if (!modal) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    if (modalContainer) {
      modalContainer.classList.remove('scale-95');
      modalContainer.classList.add('scale-100');
    }
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    if (modalContainer) {
      modalContainer.classList.remove('scale-100');
      modalContainer.classList.add('scale-95');
    }
    document.body.style.overflow = '';
  }

  openBtns.forEach((btn) => btn.addEventListener('click', openModal));
  cancelBtn?.addEventListener('click', closeModal);
  closeX?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('opacity-0')) {
      closeModal();
    }
  });

  exhibitorForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('¡Gracias por tu solicitud! Un oficial de vinculación de la Cámara de Comercio Exterior de Jujuy se pondrá en contacto a la brevedad.');
    closeModal();
  });

  // Animated stat counter (MWC style)
  function initCounters() {
    const counters = document.querySelectorAll('.stat-counter');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.getAttribute('data-target') || '0', 10);
            const prefix = el.getAttribute('data-prefix') || '';
            const suffix = el.getAttribute('data-suffix') || '';
            const duration = 1600; // ms
            const startTime = performance.now();

            function update(now: number) {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const easeOut = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
              const current = Math.floor(easeOut * target);

              el.textContent = `${prefix}${current}${suffix}`;

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                el.textContent = `${prefix}${target}${suffix}`;
              }
            }

            requestAnimationFrame(update);
            obs.unobserve(el);
          }
        });
      },
      { threshold: 0.2 }
    );

    counters.forEach((counter) => observer.observe(counter));
  }

  initCounters();
</script>

