<BaseLayout
  title="Directorio de Expositores — ExpoJuy 2026"
  description="Buscá empresas, stands, rubros e instituciones participantes en ExpoJuy 2026 con plano interactivo de Ciudad Cultural."
>
  <Header />
  <BottomNav activePage="expositores" />

  <main id="main-content" class="bg-paper min-h-screen pb-24">

    <!-- ═══════════════════════════════════════════
         EXHIBITOR HERO — High Impact Dark Theme with Image & Counters
         ═══════════════════════════════════════════ -->
    <section class="relative bg-ink text-white overflow-hidden py-14 lg:py-20 border-b border-ink/20" aria-label="Convocatoria a Expositores ExpoJuy 2026">
      {/* Background Image Container with Gradient Fade */}
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute right-0 top-0 bottom-0 w-full lg:w-3/5">
          <img
            src={`${base}Mostrar_personas_trabajando_2K_202609082137.jpeg`}
            alt="Empresas y personas trabajando en ExpoJuy"
            class="w-full h-full object-cover object-center opacity-45 mix-blend-luminosity"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-ink/40"></div>
        </div>
      </div>

      <div class="absolute inset-0 bg-gradient-puna opacity-30 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(white 1px, transparent 1px); background-size: 24px 24px;" aria-hidden="true"></div>

      <div class="container relative z-10">
        <!-- Breadcrumb -->
        <nav aria-label="Ruta de navegación" class="flex items-center gap-1.5 text-[11px] text-white/50 font-medium mb-6">
          <a href={base} class="hover:text-cyan transition-colors">Inicio</a>
          <span class="material-symbols-outlined text-[12px]" aria-hidden="true">chevron_right</span>
          <span class="text-white/90 font-semibold">Expositores</span>
        </nav>

        <div class="max-w-2xl flex flex-col gap-6">
          <Badge territory="cyan">Exposición Comercial & Feria Internacional</Badge>
          
          <h1 class="text-h1 text-white font-bold leading-tight">
            Exhibí tu Empresa en la <span class="text-cyan">Vitrina Productiva del NOA</span>
          </h1>

          <p class="text-body-lg text-white/80 leading-relaxed">
            Conectá con más de 120.000 visitantes, compradores calificados del Corredor Bioceánico e inversores internacionales en el evento socio-productivo más importante de Jujuy.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <Button href="#reserva-stand" size="lg" icon="add_business" class="shadow-violet">
              Ser Expositor / Reservar Stand
            </Button>
            <button
              type="button"
              id="btn-download-pdf-header"
              class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-pill text-small font-semibold border border-white/20 text-white/90 hover:bg-white/10 transition-all active:scale-[0.98]"
            >
              <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
              <span>Mapa del Predio (PDF)</span>
            </button>
          </div>
        </div>
      </div>
    </section>

